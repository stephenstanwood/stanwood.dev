---
import '../styles/scatosswip.css';
const { title = 'ScatosSwip — A someday home in Los Gatos' } = Astro.props;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'same-origin');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#edf4fa" />
    <meta name="description" content="A private little collection of someday homes in Los Gatos." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon-scatos.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,650;12..96,700;12..96,800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="sc-skip" href="#sc-main">Skip to homes</a>
    <main id="sc-main"><slot /></main>
  </body>
</html>
