---
import BaseLayout from "../layouts/BaseLayout.astro";
const featured = [
  {
    href: "https://nbanow.app",
    external: true,
    emoji: "🏀",
    tag: "Sports · Live",
    title: "NBA Now",
    desc: "The best NBA game to watch right now. Live scores ranked by watchability — no more flipping channels.",
    bg: "#e8f5ff",
    image: "/images/nba-now.webp",
  },
  {
    href: "https://southbaysignal.org",
    external: true,
    emoji: "📰",
    tag: "Local · News",
    title: "South Bay Signal",
    desc: "Everything happening in the South Bay — local news, events, and community coverage.",
    bg: "#FAFAF8",
    image: "/images/south-bay-signal.svg",
    light: true,
    noTitle: true,
  },
  {
    href: "/show-swipe",
    emoji: "🍿",
    tag: "Entertainment · Discovery",
    title: "Show Swipe",
    desc: "Swipe through movie and TV trailers. Right for yes, left for pass. It learns what you like.",
    bg: "#1a1a2e",
    dark: true,
    image: "/images/show-swipe.webp",
  },
];

const sportsAndFitness = [
  { href: "/wtwtw", emoji: "📺", name: "What to Watch This Week", tag: "best game each night", image: "/images/wtwtw.webp" },
  { href: "/mlb-gamerank", emoji: "⚾", name: "MLB GameRank", tag: "best game right now", image: "/images/mlb-gamerank.webp" },
  { href: "/swim", emoji: "🏊", name: "Lap Lab", tag: "your next swim workout", image: "/images/lap-lab.webp" },
];

const technology = [
  { href: "/driverless", emoji: "🚗", name: "Driverless Cars", tag: "self-driving, by the numbers", image: "/images/self-driving.webp" },
];

const weirdAndUseful = [
  { href: "/tldr", emoji: "📄", name: "TL;DR", tag: "a long PDF, the short version", image: "/images/tldr.webp" },
  { href: "/redesign-rolodex", emoji: "🎰", name: "Redesign Rolodex", tag: "redesign concepts for any website", image: "/images/redesign-rolodex.webp", mobileOnly: true },
  { href: "/which-model", emoji: "🧠", name: "Which Model?", tag: "the right AI for your task", image: "/images/which-model.webp", mobileOnly: true },
];

const local = [
  { href: "/nearest-coffee", emoji: "☕", name: "Nearest Coffee", tag: "nearest open coffee. that's it.", image: "/images/nearest-coffee.webp" },
  { href: "/green-light", emoji: "🟢", name: "Green Light", tag: "taste quiz → menu picks", image: "/images/green-light.webp" },
  { href: "/campbell", emoji: "🏛️", name: "Campbell, CA", tag: "city services, events & permits", image: "/images/campbell.webp" },
];

const justForFun = [
  { href: "/pixel-tide", emoji: "🌊", name: "Pixel Tide", tag: "no winning, just vibes", image: "/images/pixel-tide.webp" },
  { href: "/pixel-aquarium", emoji: "🐠", name: "Pixel Aquarium", tag: "feed the fish, day to night", image: "/images/pixel-aquarium.webp" },
  { href: "/museum-label", emoji: "🏷️", name: "Museum Label", tag: "deadpan placard for any object", image: "/images/museum-label.webp" },
];

const civicTech = [
  { href: "https://www.stoa.works/portfolio/budget-dashboard", emoji: "💰", name: "Budget Dashboard", tag: "Bay Area city spending, compared", image: "/images/budget-dashboard.webp" },
  { href: "https://www.stoa.works/portfolio/council-minutes", emoji: "🔍", name: "Council Minutes", tag: "AI search across 11+ city councils", image: "/images/council-minutes.webp", imageAlt: "Council Minutes Search" },
  { href: "https://www.stoa.works/portfolio/parks-map", emoji: "🌳", name: "Parks Map", tag: "south bay parks & facilities, mapped", image: "/images/parks-map.webp", imageAlt: "Parks & Facilities Map" },
];

const trademarkTools = [
  { href: "https://tmcat.app/idm", emoji: "📋", name: "ID Manual Search", tag: "74k+ identifications", image: "/images/id-manual.webp" },
  { href: "https://tmcat.app/tmep", emoji: "📖", name: "TMEP", tag: "examining procedure manual", image: "/images/tmep.webp" },
  { href: "https://tmcat.app/ttab", emoji: "⚖️", name: "TTAB Decisions", tag: "full-text search, 43k+ decisions", image: "/images/ttab-decisions.webp" },
];
const groups = [
  { name: "Everyday", projects: local },
  { name: "Sports & fitness", projects: sportsAndFitness },
  { name: "Useful little tools", projects: [...weirdAndUseful, ...technology,
    { href: "/radar", emoji: "📡", name: "AI Radar", tag: "new AI releases, straight to the source", image: "/images/ai-radar.webp" },
    { href: "/ship-clock", emoji: "🕒", name: "Ship Clock", tag: "the latest from stanwood.dev", image: "/images/ship-clock.webp" },
  ] },
  { name: "A little play", projects: justForFun },
  { name: "Civic tech", projects: civicTech },
  { name: "Trademark tools", projects: trademarkTools },
];
---
<BaseLayout title="Stephen Stanwood — Apps & little experiments"
  description="Useful apps, quiet games, and little experiments by Stephen Stanwood."
  slug="" themeColor="#fffef5" schemaType="WebSite" schemaName="stanwood.dev"
  fontsUrl="https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap">
  <div class="hub">
    <nav class="hub-nav" aria-label="Main"><a href="/">stanwood.dev</a><div><a href="/about">About</a><a href="/shop">Shop</a><a href="mailto:stephen@stanwood.dev">Say hello ↗</a></div></nav>
    <header class="hub-intro">
      <div><p class="hub-kicker">Made in Campbell, California.</p><h1>Little tools.<br />More possibility.</h1><p class="hub-deck">Apps, games, and experiments by Stephen Stanwood.<br />Built to make life simpler &amp; more fun.</p></div>
      <a href="/about" class="hub-portrait" aria-label="About Stephen Stanwood"><img src="/images/headshot-sketch.webp" alt="" width="360" height="360" /></a>
    </header>
    <section class="hub-featured" aria-labelledby="featured-heading">
      <h2 id="featured-heading">A few favorites</h2>
      <div class="hub-feature-grid">{featured.map(project => (
        <a href={project.href} class="hub-feature" target={project.external ? "_blank" : undefined} rel={project.external ? "noopener noreferrer" : undefined}>
          <div class="hub-feature-image" style={`background: ${project.bg}`}><img src={project.image} alt="" width="640" height="360" loading="lazy" /></div>
          <div class="hub-feature-copy"><h3>{project.title}<span aria-hidden="true">↗</span></h3><p>{project.desc}</p></div>
        </a>
      ))}</div>
    </section>
    {groups.map(group => (
      <section class="hub-group" aria-label={group.name}>
        <h2>{group.name}</h2>
        <div class="hub-project-grid">{group.projects.map(project => (
          <a class="hub-project" href={project.href}>
            <img src={project.image} alt="" width="160" height="160" loading="lazy" />
            <div><h3>{project.name}</h3><p>{project.tag}</p></div><span class="hub-arrow" aria-hidden="true">↗</span>
          </a>
        ))}</div>
      </section>
    ))}
    <footer class="hub-footer"><span>Small things, made with care.</span><nav aria-label="Social"><a href="https://github.com/stephenstanwood">GitHub</a><a href="https://x.com/stephenstanwood">Twitter</a><a href="https://www.linkedin.com/in/stephenstanwood">LinkedIn</a></nav></footer>
  </div>
</BaseLayout>
<style>
  :global(body) { background: #fffef5; color: #171712; font-family: 'Cabin', sans-serif; }
  * { box-sizing: border-box; }
  a { color: inherit; text-decoration: none; }
  .hub { max-width: 1080px; margin: auto; padding: 0 28px; }
  .hub-nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 0; border-bottom: 1px solid #c9c8bc; font: 12px 'Space Mono', monospace; }
  .hub-nav > a { font-weight: 700; }
  .hub-nav > div { display: flex; gap: 20px; }
  .hub-nav a { padding: 6px 0; }
  .hub-intro { display: grid; grid-template-columns: 1fr 200px; align-items: center; gap: 40px; margin: 36px 0 44px; padding: 36px; background: #f5e642; border: 2px solid #171712; box-shadow: 5px 5px 0 #171712; }
  .hub-kicker { font: 11px 'Space Mono', monospace; margin: 0 0 16px; }
  h1 { font: 400 clamp(36px, 5.5vw, 58px)/1.12 'Permanent Marker', cursive; letter-spacing: -.035em; margin: 0; }
  .hub-deck { font-size: 16px; line-height: 1.6; margin: 18px 0 0; }
  .hub-portrait { display: block; }
  .hub-portrait img { width: 100%; height: auto; mix-blend-mode: multiply; }
  h2 { font: 700 12px 'Space Mono', monospace; margin: 0 0 20px; }
  .hub-feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .hub-feature { border: 1px solid #bdbcb0; background: #fff; transition: border-color .15s; }
  .hub-feature-image { aspect-ratio: 16 / 9; overflow: hidden; }
  .hub-feature img { width: 100%; height: 100%; object-fit: cover; }
  .hub-feature-copy { padding: 20px; }
  .hub-feature h3 { display: flex; justify-content: space-between; gap: 12px; font-size: 20px; line-height: 1.2; margin: 0; font-weight: 700; }
  .hub-feature p { color: #57584e; font-size: 14px; line-height: 1.5; margin: 12px 0 0; }
  .hub-feature:hover { border-color: #171712; }
  .hub-group { margin-top: 40px; padding-top: 24px; border-top: 1px solid #c9c8bc; }
  .hub-project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 24px; }
  .hub-project { display: flex; align-items: center; gap: 14px; min-width: 0; min-height: 80px; padding: 8px 0; }
  .hub-project img { width: 56px; height: 56px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .hub-project h3 { margin: 0; font-size: 16px; line-height: 1.25; font-weight: 650; }
  .hub-project p { margin: 5px 0 0; font-size: 12px; color: #57584e; line-height: 1.4; }
  .hub-arrow { margin-left: auto; color: #727365; }
  .hub-project:hover h3, .hub-nav a:hover, .hub-footer a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hub-footer { display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid #c9c8bc; margin-top: 48px; padding: 28px 0 36px; font-size: 12px; color: #57584e; }
  .hub-footer nav { display: flex; gap: 18px; }
  @media (max-width: 800px) { .hub-project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hub-feature-grid { gap: 12px; } .hub-feature-copy { padding: 16px; } .hub-intro { grid-template-columns: 1fr 130px; gap: 20px; padding: 28px; } }
  @media (max-width: 540px) { .hub { padding: 0 20px; } .hub-nav { padding: 18px 0; font-size: 10px; } .hub-nav > div { gap: 14px; } .hub-intro { display: block; padding: 24px; margin: 24px 0 32px; position: relative; } .hub-portrait { display: none; } .hub-deck { font-size: 14px; } .hub-kicker { font-size: 10px; } .hub-feature-grid { grid-template-columns: 1fr; gap: 16px; } .hub-feature { display: grid; grid-template-columns: 104px 1fr; } .hub-feature-image { height: 100%; aspect-ratio: auto; } .hub-feature-copy { padding: 16px; } .hub-feature h3 { font-size: 17px; } .hub-feature p { font-size: 12px; margin-top: 8px; } .hub-project-grid { grid-template-columns: 1fr; gap: 8px; } .hub-group { margin-top: 28px; } .hub-footer { flex-direction: column; gap: 14px; } }
</style>
