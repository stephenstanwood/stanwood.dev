---
// Personal, unlisted: classes at Courtside and Club LG that finish by 5:30 PM on weekdays and by
// noon on weekends. Rendered per request from both clubs' live schedules; the CDN keeps a copy for
// five minutes.
export const prerender = false;

import "@fontsource/young-serif/latin-400.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CLUB_NAMES, clockLabel, daySummary, endLabel, windowWords } from "../lib/workouts/labels";
import { MODALITY_LABELS, type Modality } from "../lib/workouts/modality";
import { WEEKDAY_WINDOW, WEEKEND_WINDOW, getWorkoutSchedule } from "../lib/workouts/schedule";
import { CLUBLG_SCHEDULE_URL, COURTSIDE_SCHEDULE_URL } from "../lib/workouts/sources";
import type { ClubKey, ScheduleDay } from "../lib/workouts/types";
import { PACIFIC_TZ, formatHourMinuteInTz } from "../lib/dateFormat";

const schedule = await getWorkoutSchedule();
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300, stale-while-revalidate=600");

const SCHEDULE_URLS: Record<ClubKey, string> = {
  courtside: COURTSIDE_SCHEDULE_URL,
  clublg: CLUBLG_SCHEDULE_URL,
};
const CHILDCARE = {
  courtside: "https://bayclubconnect.com/childcare",
  clublg: "https://www.theclublg.com/kidsclub",
};
const failed = (Object.keys(schedule.sources) as ClubKey[]).filter((club) => !schedule.sources[club].ok);

const MODALITY_ORDER: Modality[] = ["strength", "pilates", "yoga", "cardio", "court", "swim", "other"];
const onScreen = schedule.days.filter((day) => !day.extra).flatMap((day) => day.classes);
const legend = MODALITY_ORDER.filter((modality) => onScreen.some((item) => item.modality === modality));

const between = (day: ScheduleDay) => windowWords(day.window.startMin, day.window.endMin);

// Today's one-line summary (first paint; the script keeps it current through the day).
function summaryFor(day: ScheduleDay): string {
  if (day.classes.length === 0) return `Nothing between ${between(day)} today.`;
  return daySummary(day.classes.map((item) => ({ start: item.startMin, name: item.title })), 0);
}

const rowId = (id: string) => `c-${id.replace(/[^a-zA-Z0-9_-]/g, "")}`;
const updated = formatHourMinuteInTz(schedule.generatedAt, PACIFIC_TZ);
---

<BaseLayout
  title="Workouts — stanwood.dev"
  description="Classes at Bay Club Courtside and The Club at Los Gatos that finish by 5:30 PM on weekdays and by noon on weekends, today first."
  slug="workouts"
  favicon="/favicon-workouts.svg"
  themeColor="#e7f2f4"
  schemaCategory="HealthApplication"
  schemaName="Workouts"
  fontsUrl="data:text/css,"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="wo" data-workouts data-today={schedule.todayIso} data-generated={schedule.generatedAt} data-unavailable={failed.join(",")}>
    <a href="/" class="retro-back">← stanwood.dev</a>

    <header class="head">
      <h1>Workouts</h1>
      <p>
        Classes at Courtside and Club LG that end by {endLabel(WEEKDAY_WINDOW.endMin)} on weekdays and by
        {endLabel(WEEKEND_WINDOW.endMin)} on weekends.
      </p>
    </header>

    <p class="care">
      <strong>Childcare</strong> runs 3–7 weekdays and 8–1 weekends at both clubs. Reserve at
      <a href={CHILDCARE.courtside} target="_blank" rel="noopener">Courtside</a> or
      <a href={CHILDCARE.clublg} target="_blank" rel="noopener">Club LG</a>.
    </p>

    <search class="club-filter" aria-label="Filter classes by club" data-club-filter hidden>
      <fieldset>
        <legend class="sr-only">Show classes at</legend>
        <div class="club-options">
          {[
            ["both", "Both"],
            ["courtside", CLUB_NAMES.courtside],
            ["clublg", CLUB_NAMES.clublg],
          ].map(([value, label]) => (
            <div class="club-option">
              <input class="sr-only" type="radio" name="club" id={`club-${value}`} value={value} checked={value === "both"} />
              <label for={`club-${value}`}>{label}</label>
            </div>
          ))}
        </div>
      </fieldset>
    </search>

    {failed.map((club) => (
      <p class="alert" role="status" data-source-club={club}>
        {CLUB_NAMES[club]}’s schedule didn’t load, so its classes are missing.
        <a href={SCHEDULE_URLS[club]} target="_blank" rel="noopener">Open the {CLUB_NAMES[club]} schedule</a>
      </p>
    ))}

    {schedule.days.map((day) => (
      <section
        class:list={["day", { "is-today": day.isToday }]}
        aria-labelledby={`day-${day.date}`}
        data-date={day.date}
        data-heading={day.heading}
        data-window-end={day.window.endMin}
        data-window-label={between(day)}
        data-extra={day.extra ? "" : undefined}
        hidden={day.extra}
      >
        <h2 class="day-head" id={`day-${day.date}`}>
          {day.heading}
          <span class="day-date">{day.dateLabel}</span>
        </h2>
        {day.isToday && <p class="day-summary" data-day-summary aria-live="polite" aria-atomic="true">{summaryFor(day)}</p>}

        {day.classes.length > 0 ? (
          <ol class="classes">
            {day.classes.map((item) => (
              <li
                class:list={["cls", `m-${item.modality}`]}
                id={rowId(item.id)}
                data-start={item.startMin}
                data-end={item.endMin}
                data-name={item.title}
                data-club={item.club}
                data-modality={item.modality}
              >
                <a href={item.url} target="_blank" rel="noopener">
                  <span class="time">
                    <span class="start">{clockLabel(item.startMin)}</span>
                    <span class="end">to {endLabel(item.endMin)}</span>
                  </span>
                  <span class="info">
                    <span class="name">{item.title}</span>
                    <span class="who">
                      {item.instructor ?? "Instructor not listed"}
                      {item.substitute && <span class="sub"> (sub)</span>}
                    </span>
                    <span class="where">
                      <span class="club">{CLUB_NAMES[item.club]}</span>{item.room && `, ${item.room}`}
                    </span>
                    {item.tags.length > 0 && (
                      <span class="tags">
                        {item.tags.map((tag) => <span class:list={["tag", tag.kind]}>{tag.label}</span>)}
                      </span>
                    )}
                    <span class="state" data-state hidden></span>
                  </span>
                  <span class="sr-only"> Opens the {CLUB_NAMES[item.club]} schedule.</span>
                </a>
              </li>
            ))}
          </ol>
        ) : null}
        <p class="empty" data-day-empty hidden={day.classes.length > 0 || day.isToday}>
          {failed.length === 2 ? "No schedule to show." : `Nothing between ${between(day)}.`}
        </p>
      </section>
    ))}

    <footer class="foot">
      {legend.length > 0 && (
        <ul class="legend" aria-label="Color key">
          {legend.map((modality) => (
            <li class:list={["legend-item", `m-${modality}`]}>{MODALITY_LABELS[modality]}</li>
          ))}
        </ul>
      )}
      <p>
        Updated {updated} from the clubs’ own schedules. Full listings:{" "}
        <a href={COURTSIDE_SCHEDULE_URL} target="_blank" rel="noopener">Courtside</a>,{" "}
        <a href={CLUBLG_SCHEDULE_URL} target="_blank" rel="noopener">Club LG</a>.
      </p>
    </footer>
  </div>
</BaseLayout>

<script>
  // Keeps today current without pressure: classes that have ended drop away, the one under way
  // is marked, and once today's window closes the reserve day keeps a full week on screen.
  // Updates each minute.
  import { CLUB_NAMES, daySummary } from "../lib/workouts/labels";

  const TZ = "America/Los_Angeles";
  const STALE_MS = 15 * 60_000;
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: TZ,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  });

  // ?at=16:40 previews the page at another time of day.
  const at = /^(\d{1,2}):(\d{2})$/.exec(new URLSearchParams(location.search).get("at") ?? "");

  function pacificNow() {
    const p: Record<string, string> = {};
    for (const part of parts.formatToParts(new Date())) p[part.type] = part.value;
    const minutes = at ? Number(at[1]) * 60 + Number(at[2]) : Number(p.hour) * 60 + Number(p.minute);
    return { date: `${p.year}-${p.month}-${p.day}`, minutes };
  }

  const root = document.querySelector<HTMLElement>("[data-workouts]");
  type ClubFilter = "both" | "courtside" | "clublg";
  const STORAGE_KEY = "workouts-club";
  let selectedClub: ClubFilter = "both";

  function emptyMessage(day: HTMLElement) {
    const unavailable = (root?.dataset.unavailable ?? "").split(",").filter(Boolean);
    if (selectedClub === "both" ? unavailable.length === 2 : unavailable.includes(selectedClub)) {
      return "No schedule to show.";
    }
    return selectedClub === "both"
      ? `Nothing between ${day.dataset.windowLabel}.`
      : `No ${CLUB_NAMES[selectedClub]} classes between ${day.dataset.windowLabel}.`;
  }

  function update() {
    if (!root) return;
    root.querySelectorAll<HTMLElement>(".day").forEach((day) => {
      const rows = [...day.querySelectorAll<HTMLElement>(".cls")];
      rows.forEach((row) => {
        row.hidden = selectedClub !== "both" && row.dataset.club !== selectedClub;
      });
      const hasClasses = rows.some((row) => !row.hidden);
      const list = day.querySelector<HTMLElement>(".classes");
      if (list) list.hidden = !hasClasses;
      const empty = day.querySelector<HTMLElement>("[data-day-empty]");
      if (empty) {
        empty.hidden = hasClasses || day.classList.contains("is-today");
        empty.textContent = emptyMessage(day);
      }
    });
    root.querySelectorAll<HTMLElement>("[data-source-club]").forEach((alert) => {
      alert.hidden = selectedClub !== "both" && alert.dataset.sourceClub !== selectedClub;
    });

    const now = pacificNow();
    if (now.date !== root.dataset.today) {
      // Rendered on an earlier day: fetch a fresh copy (the query string skips the CDN copy).
      const url = new URL(location.href);
      if (url.searchParams.get("d") !== now.date) {
        url.searchParams.set("d", now.date);
        location.replace(url);
      }
      return;
    }

    const today = root.querySelector<HTMLElement>(".day.is-today");
    if (!today) return;
    const windowEnd = Number(today.dataset.windowEnd);
    const allRows = [...today.querySelectorAll<HTMLElement>(".cls")];
    let underwayCount = 0;
    for (const row of allRows) {
      const start = Number(row.dataset.start);
      const end = Number(row.dataset.end);
      const over = end <= now.minutes;
      const underway = start <= now.minutes && !over;
      if (underway) underwayCount++;
      row.classList.toggle("is-over", over);
      row.classList.toggle("is-underway", underway);
      const state = row.querySelector<HTMLElement>("[data-state]");
      if (state) {
        state.hidden = !underway;
        state.textContent = underway ? "Under way now" : "";
      }
    }
    const rows = allRows.filter((row) => !row.hidden);
    const selectedOver = rows.length > 0 && rows.every((row) => Number(row.dataset.end) <= now.minutes);
    const list = today.querySelector<HTMLElement>(".classes");
    if (list) list.hidden = !rows.length || selectedOver;
    const upcoming = rows.filter((row) => Number(row.dataset.start) > now.minutes);
    const started = rows.length - upcoming.length;
    const over = now.minutes >= windowEnd || (
      allRows.length > 0 && allRows.every((row) => Number(row.dataset.start) <= now.minutes) && underwayCount === 0
    );
    today.classList.toggle("is-done", over);

    const summary = today.querySelector<HTMLElement>("[data-day-summary]");
    if (summary) {
      if (!rows.length) {
        summary.textContent = emptyMessage(today);
      } else if (over || selectedOver) {
        summary.textContent = "That’s it for today.";
      } else {
        const next = upcoming.map((row) => ({ start: Number(row.dataset.start), name: row.dataset.name ?? "" }));
        summary.textContent = daySummary(next, started);
      }
    }

    // Once today is over, the reserve day keeps a full week on the page.
    root.querySelectorAll<HTMLElement>("[data-extra]").forEach((section) => {
      section.hidden = !over;
    });
  }

  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved === "both" || saved === "courtside" || saved === "clublg") selectedClub = saved;
  } catch {
    // Filtering still works when the browser doesn't allow saved preferences.
  }
  root?.querySelectorAll<HTMLInputElement>('input[name="club"]').forEach((input) => {
    input.checked = input.value === selectedClub;
    input.addEventListener("change", () => {
      if (!input.checked) return;
      selectedClub = input.value as ClubFilter;
      try {
        localStorage.setItem(STORAGE_KEY, selectedClub);
      } catch {
        // Keep the current selection for this visit.
      }
      update();
    });
  });
  update();
  const filter = root?.querySelector<HTMLElement>("[data-club-filter]");
  if (filter) filter.hidden = false;
  setInterval(update, 60_000);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden || !root) return;
    if (Date.now() - Date.parse(root.dataset.generated ?? "") > STALE_MS) location.reload();
    else update();
  });
</script>

<style is:global>
  :root {
    --wo-canvas: #fbfcfc;
    --wo-sky: #e7f2f4;
    --wo-ink: #1f2a33;
    --wo-muted: #63707a;
    --wo-line: #e4eaed;
    --wo-card: #ffffff;
    --wo-accent: #2c7c87;
  }
  html {
    scroll-padding-top: 24px;
  }
  body {
    margin: 0;
    color: var(--wo-ink);
    background: linear-gradient(180deg, var(--wo-sky) 0, var(--wo-canvas) 420px) no-repeat, var(--wo-canvas);
    font-family: "Cabin Variable", "Cabin", system-ui, sans-serif;
  }
  /* Class-type tints: a soft fill and a deeper shade for text on it. */
  .m-strength { --tint: #fbe3da; --deep: #a2462e; }
  .m-pilates { --tint: #e2e7fb; --deep: #3d4e9f; }
  .m-yoga { --tint: #dcefe2; --deep: #2c6b48; }
  .m-cardio { --tint: #fbefc8; --deep: #7a590c; }
  .m-court { --tint: #e7f1cc; --deep: #4f6419; }
  .m-swim { --tint: #d7eef2; --deep: #1d6676; }
  .m-other { --tint: #eceff1; --deep: #4a5560; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<style>
  .wo {
    --serif: "Young Serif", Georgia, serif;
    width: min(100% - 32px, 640px);
    margin: 0 auto;
    padding: 18px 0 56px;
  }

  .head {
    margin: 30px 0 22px;
  }
  .head h1 {
    margin: 0;
    font: 400 clamp(40px, 10vw, 54px) / 1.05 var(--serif);
    letter-spacing: -0.01em;
  }
  .head p {
    margin: 10px 0 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--wo-muted);
  }

  .wo [hidden] {
    display: none;
  }
  .club-filter {
    margin-top: 22px;
  }
  .club-filter fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .club-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--wo-line);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.72);
  }
  .club-option label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 48px;
    padding-inline: 6px;
    border-radius: 11px;
    color: var(--wo-muted);
    font-size: 1rem;
    font-weight: 650;
    cursor: pointer;
  }
  .club-option label:hover {
    background: var(--wo-sky);
  }
  .club-option input:checked + label {
    color: #fff;
    background: var(--wo-accent);
    box-shadow: 0 1px 3px rgba(31, 42, 51, 0.12);
  }
  .club-option input:focus-visible + label {
    outline: 2px solid var(--wo-ink);
    outline-offset: 2px;
  }

  /* A quiet reminder, not a card. */
  .care {
    margin: 0;
    padding: 11px 15px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--wo-line);
    font-size: 15px;
    line-height: 1.5;
    color: var(--wo-muted);
  }
  .care strong {
    color: var(--wo-ink);
    font-weight: 650;
  }
  .care a {
    color: var(--wo-accent);
    font-weight: 650;
    text-underline-offset: 2px;
  }

  .alert {
    margin: 18px 0 0;
    padding: 12px 16px;
    border-radius: 14px;
    background: #fff4e5;
    font-size: 15px;
    line-height: 1.45;
  }
  .alert a {
    display: block;
    margin-top: 4px;
    font-weight: 650;
    color: var(--wo-accent);
  }

  /* Days */
  .day {
    margin-top: 32px;
  }
  .day[hidden] {
    display: none;
  }
  .day-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 10px;
    margin: 0 0 12px 4px;
    font: 400 27px/1.15 var(--serif);
  }
  .day-date {
    font: 600 15px/1 "Cabin Variable", "Cabin", sans-serif;
    color: var(--wo-muted);
  }
  .day-summary {
    margin: -4px 0 12px 4px;
    font-size: 16px;
    line-height: 1.45;
    color: var(--wo-muted);
  }

  .classes {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--wo-card);
    border: 1px solid var(--wo-line);
    border-radius: 20px;
    box-shadow: 0 1px 2px rgba(31, 42, 51, 0.04);
    overflow: hidden;
  }
  .cls:not([hidden]):not(.is-over) ~ .cls:not([hidden]):not(.is-over) a {
    border-top: 1px solid var(--wo-line);
  }
  .cls a {
    display: grid;
    grid-template-columns: 68px 1fr;
    gap: 14px;
    padding: 14px 16px;
    color: inherit;
    text-decoration: none;
  }
  .cls a:hover {
    background: #f6f9fa;
  }
  .cls a:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .time {
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9px 4px 8px;
    border-radius: 14px;
    background: var(--tint);
    color: var(--deep);
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }
  .start {
    font-size: 19px;
    font-weight: 700;
  }
  .end {
    font-size: 12.5px;
    font-weight: 600;
    opacity: 0.85;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding-top: 2px;
  }
  .name {
    font-size: 17.5px;
    font-weight: 650;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .who {
    font-size: 15px;
  }
  .sub {
    color: var(--wo-muted);
  }
  .where {
    font-size: 14px;
    color: var(--wo-muted);
  }
  .club {
    font-weight: 650;
    color: var(--wo-ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 6px;
  }
  .tag {
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1;
    padding: 5px 9px;
    border-radius: 999px;
    border: 1px solid var(--wo-line);
    color: var(--wo-muted);
    background: #fff;
  }
  .state {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 650;
    color: var(--wo-accent);
  }
  .state[hidden] {
    display: none;
  }

  /* Live states */
  .cls.is-over,
  .is-done .classes,
  .is-done .empty {
    display: none;
  }
  .cls.is-underway :is(.time, .name, .who, .where, .tags) {
    opacity: 0.55;
  }

  .empty {
    margin: 10px 0 0 4px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--wo-muted);
  }

  .foot {
    margin-top: 40px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--wo-muted);
  }
  .foot p {
    margin: 12px 0 0;
  }
  .foot a {
    color: inherit;
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
  }
  .legend-item {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--deep);
    font-size: 12.5px;
    font-weight: 650;
  }

  @media (min-width: 720px) {
    .head {
      margin-top: 44px;
    }
    .cls a {
      grid-template-columns: 76px 1fr;
      gap: 18px;
      padding: 16px 20px;
    }
  }
</style>
