---
// Personal, unlisted: weekday classes at Courtside and Club LG that finish by 5:30 PM.
// Rendered per request from both clubs' live schedules; the CDN keeps a copy for five minutes.
export const prerender = false;

import "@fontsource-variable/big-shoulders/opsz.css";
import "@fontsource/dseg7-classic/latin-700.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { clockLabel } from "../lib/workouts/clock";
import { MODALITY_LABELS, type Modality } from "../lib/workouts/modality";
import { CLUB_NAMES, CUTOFF_MIN, getAfternoonSchedule } from "../lib/workouts/schedule";
import { CLUBLG_SCHEDULE_URL, COURTSIDE_SCHEDULE_URL } from "../lib/workouts/sources";
import type { ClubKey } from "../lib/workouts/types";
import { PACIFIC_TZ, formatHourMinuteInTz } from "../lib/dateFormat";

const schedule = await getAfternoonSchedule();
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300, stale-while-revalidate=600");

const SCHEDULE_URLS: Record<ClubKey, string> = {
  courtside: COURTSIDE_SCHEDULE_URL,
  clublg: CLUBLG_SCHEDULE_URL,
};
const CHILDCARE = {
  courtside: "https://bayclubconnect.com/childcare",
  clublg: "https://www.theclublg.com/kidsclub",
};
const failed = (Object.keys(schedule.sources) as ClubKey[]).filter((club) => !schedule.sources[club].ok);

const MODALITY_ORDER: Modality[] = ["strength", "pilates", "yoga", "cardio", "court", "swim", "other"];
const onScreen = schedule.days.filter((day) => !day.extra).flatMap((day) => day.classes);
const legend = MODALITY_ORDER.filter((modality) => onScreen.some((item) => item.modality === modality));

// First paint for the clock: the earliest class on the first day that has one. The script
// below takes over at once with a live countdown and drops anything already started.
const firstDay = schedule.days.find((day) => !day.extra && day.classes.length > 0);
const firstStart = firstDay?.classes[0]?.startMin;
const firstGroup = firstDay?.classes.filter((item) => item.startMin === firstStart) ?? [];
const firstWhen = !firstDay ? "" : firstDay.isToday ? "today" : firstDay.heading === "Tomorrow" ? "tomorrow" : firstDay.heading;

const rowId = (id: string) => `c-${id.replace(/[^a-zA-Z0-9_-]/g, "")}`;
const updated = formatHourMinuteInTz(schedule.generatedAt, PACIFIC_TZ);
---

<BaseLayout
  title="Afternoon classes — stanwood.dev"
  description="Weekday classes at Bay Club Courtside and The Club at Los Gatos that finish by 5:30 PM, today first."
  slug="workouts"
  favicon="/favicon-workouts.svg"
  themeColor="#f2f4f6"
  schemaCategory="HealthApplication"
  schemaName="Afternoon classes"
  fontsUrl="data:text/css,"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="wo" data-workouts data-today={schedule.todayIso} data-generated={schedule.generatedAt}>
    <div class="side">
      <div class="topbar">
        <a href="/" class="retro-back">← stanwood.dev</a>
        <span class="updated">Updated {updated}</span>
      </div>

      <section class="clock" aria-labelledby="clock-title">
        <div class="clock-face">
          <h1 class="clock-title" id="clock-title">Done by 5:30</h1>
          <p class="clock-clubs">Courtside and Club LG, weekdays</p>
          <p class="clock-label" data-clock-label>
            {firstGroup.length ? `Next class ${firstWhen} at` : "No classes on the board"}
          </p>
          <div class="led" aria-hidden="true">
            <span class="led-ghost" data-led-ghost>{firstStart ? clockLabel(firstStart).replace(/\d/g, "8") : "88:88"}</span>
            <span class="led-digits" data-led>{firstStart ? clockLabel(firstStart) : "--:--"}</span>
          </div>
          <p class="sr-only" data-clock-sr>
            {firstGroup.length ? `Next class ${firstWhen} at ${clockLabel(firstStart ?? 0)} PM.` : "No classes on the board."}
          </p>
          <p class="clock-next" data-clock-next>
            {firstGroup.length > 1 ? `${firstGroup.length} classes to pick from` : firstGroup[0] ? `${firstGroup[0].title}, ${CLUB_NAMES[firstGroup[0].club]}` : ""}
          </p>
          <ul class="clock-picks" data-clock-picks>
            {firstGroup.map((item) => (
              <li><a class:list={["pick", `m-${item.modality}`]} href={`#${rowId(item.id)}`}>{item.title}</a></li>
            ))}
          </ul>
        </div>
      </section>

      <p class="care">
        <strong>Childcare 3–7</strong> at both clubs. Reserve at
        <a href={CHILDCARE.courtside} target="_blank" rel="noopener">Courtside</a> or
        <a href={CHILDCARE.clublg} target="_blank" rel="noopener">Club LG</a>.
      </p>
    </div>

    <div class="board">
      {failed.map((club) => (
        <p class="alert" role="status">
          {CLUB_NAMES[club]}’s schedule didn’t load, so its classes are missing.
          <a href={SCHEDULE_URLS[club]} target="_blank" rel="noopener">Open the {CLUB_NAMES[club]} schedule</a>
        </p>
      ))}

      {schedule.days.map((day) => (
        <section
          class:list={["day", { "is-today": day.isToday }]}
          aria-labelledby={`day-${day.date}`}
          data-date={day.date}
          data-heading={day.heading}
          data-extra={day.extra ? "" : undefined}
          hidden={day.extra}
        >
          <h2 class="day-head" id={`day-${day.date}`}>
            <span class="day-name">{day.heading}</span>
            <span class="day-date">{day.dateLabel}</span>
          </h2>
          {day.isToday && <p class="day-done" data-day-done hidden>Done for today.</p>}

          {day.classes.length > 0 ? (
            <ol class="tickets">
              {day.classes.map((item) => (
                <li
                  class:list={["ticket", `m-${item.modality}`]}
                  id={rowId(item.id)}
                  data-start={item.startMin}
                  data-end={item.endMin}
                  data-name={item.title}
                  data-club={CLUB_NAMES[item.club]}
                  data-modality={item.modality}
                >
                  <a href={item.url} target="_blank" rel="noopener">
                    <span class="t-time">
                      <span class="t-start">{clockLabel(item.startMin)}</span>
                      <span class="t-end">{item.endMin === CUTOFF_MIN ? "ends 5:30" : `to ${clockLabel(item.endMin)}`}</span>
                    </span>
                    <span class="t-body">
                      <span class="t-top">
                        <span class="t-name">{item.title}</span>
                        <span class:list={["club", item.club]}>{CLUB_NAMES[item.club]}</span>
                      </span>
                      <span class="t-who">
                        {item.instructor ?? "Instructor not listed"}
                        {item.substitute && <span class="t-sub"> (sub)</span>}
                      </span>
                      {item.room && <span class="t-where">{item.room}</span>}
                      {item.tags.length > 0 && (
                        <span class="t-tags">
                          {item.tags.map((tag) => <span class:list={["tag", tag.kind]}>{tag.label}</span>)}
                        </span>
                      )}
                      <span class="t-live" data-live hidden></span>
                    </span>
                    <span class="sr-only"> Opens the {CLUB_NAMES[item.club]} schedule.</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="empty">{failed.length === 2 ? "No schedule to show." : "Nothing between 3 and 5:30."}</p>
          )}

          {day.cancelled.length > 0 && (
            <p class="cancelled">
              Cancelled:{" "}
              {day.cancelled
                .map((item) => `${item.title} at ${clockLabel(item.startMin)} (${CLUB_NAMES[item.club]})`)
                .join("; ")}
            </p>
          )}
        </section>
      ))}

      <footer class="foot">
        {legend.length > 0 && (
          <ul class="legend" aria-label="Color key">
            {legend.map((modality) => (
              <li><span class:list={["swatch", `m-${modality}`]} aria-hidden="true"></span>{MODALITY_LABELS[modality]}</li>
            ))}
          </ul>
        )}
        <p>
          Read live from each club’s own schedule. Full listings:{" "}
          <a href={COURTSIDE_SCHEDULE_URL} target="_blank" rel="noopener">Courtside</a>,{" "}
          <a href={CLUBLG_SCHEDULE_URL} target="_blank" rel="noopener">Club LG</a>.
        </p>
      </footer>
    </div>
  </div>
</BaseLayout>

<script>
  // The clock counts down to the next class; today's board drops finished classes, flags the
  // next start, and hands over to the next weekday once today is over.
  const TZ = "America/Los_Angeles";
  const CUTOFF = 17 * 60 + 30;
  const STALE_MS = 15 * 60_000;
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: TZ,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hourCycle: "h23",
  });

  // ?at=16:40 previews the board at another time of day.
  const at = /^(\d{1,2}):(\d{2})$/.exec(new URLSearchParams(location.search).get("at") ?? "");

  function pacificNow() {
    const p: Record<string, string> = {};
    for (const part of parts.formatToParts(new Date())) p[part.type] = part.value;
    const seconds = at
      ? Number(at[1]) * 3600 + Number(at[2]) * 60
      : Number(p.hour) * 3600 + Number(p.minute) * 60 + Number(p.second);
    return { date: `${p.year}-${p.month}-${p.day}`, seconds, minutes: Math.floor(seconds / 60) };
  }

  const pad = (n: number) => String(n).padStart(2, "0");
  const clock = (minutes: number) => `${Math.floor(minutes / 60) % 12 || 12}:${pad(minutes % 60)}`;
  function countdown(seconds: number) {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = seconds % 60;
    return h ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
  }
  function inWords(minutes: number) {
    if (minutes < 60) return `${minutes} min`;
    const h = Math.floor(minutes / 60);
    const m = minutes % 60;
    return m ? `${h} hr ${m} min` : `${h} hr`;
  }

  const root = document.querySelector<HTMLElement>("[data-workouts]");
  const q = <T extends Element = HTMLElement>(selector: string) => root?.querySelector<T>(selector) ?? null;
  const led = q("[data-led]");
  const ghost = q("[data-led-ghost]");
  const label = q("[data-clock-label]");
  const next = q("[data-clock-next]");
  const picks = q("[data-clock-picks]");
  const sr = q("[data-clock-sr]");
  let lastGroupKey = "";

  function setLed(text: string) {
    if (led && led.textContent !== text) led.textContent = text;
    const blank = text.replace(/\d/g, "8").replace(/-/g, "8");
    if (ghost && ghost.textContent !== blank) ghost.textContent = blank;
    if (led) led.dataset.len = String(text.length);
    if (ghost) ghost.dataset.len = String(text.length);
  }

  function tick() {
    if (!root) return;
    const now = pacificNow();
    if (now.date !== root.dataset.today) {
      // Rendered on an earlier day: fetch a fresh copy (the query string skips the CDN copy).
      const url = new URL(location.href);
      if (url.searchParams.get("d") !== now.date) {
        url.searchParams.set("d", now.date);
        location.replace(url);
      }
      return;
    }

    // Today's board.
    const today = root.querySelector<HTMLElement>(".day.is-today");
    let todayDone = false;
    if (today) {
      const rows = [...today.querySelectorAll<HTMLElement>(".ticket")];
      for (const row of rows) {
        const start = Number(row.dataset.start);
        const end = Number(row.dataset.end);
        const over = end <= now.minutes;
        const running = start <= now.minutes && !over;
        row.classList.toggle("is-over", over);
        row.classList.toggle("is-running", running);
        const live = row.querySelector<HTMLElement>("[data-live]");
        if (!live) continue;
        const wait = start - now.minutes;
        live.hidden = !(running || (!over && wait <= 60));
        live.classList.toggle("soon", !running && wait <= 20);
        if (running) live.textContent = `Started ${inWords(now.minutes - start)} ago`;
        else if (!over && wait <= 60) live.textContent = wait <= 0 ? "Starting now" : `Starts in ${inWords(wait)}`;
      }
      todayDone = now.minutes >= CUTOFF || (rows.length > 0 && rows.every((row) => row.classList.contains("is-over")));
      today.classList.toggle("is-done", todayDone);
      const done = today.querySelector<HTMLElement>("[data-day-done]");
      if (done) done.hidden = !todayDone;
    }
    root.querySelectorAll<HTMLElement>("[data-extra]").forEach((section) => {
      section.hidden = !todayDone;
    });

    // The clock: the next class that hasn't started, today first.
    let group: HTMLElement[] = [];
    let groupDay: HTMLElement | null = null;
    for (const day of root.querySelectorAll<HTMLElement>("section.day:not([hidden])")) {
      const isToday = day.classList.contains("is-today");
      const upcoming = [...day.querySelectorAll<HTMLElement>(".ticket")].filter(
        (row) => !isToday || Number(row.dataset.start) * 60 > now.seconds,
      );
      if (upcoming.length) {
        const start = upcoming[0].dataset.start;
        group = upcoming.filter((row) => row.dataset.start === start);
        groupDay = day;
        break;
      }
    }
    root.querySelectorAll(".ticket.is-next").forEach((row) => row.classList.remove("is-next"));
    group.forEach((row) => row.classList.add("is-next"));

    if (!group.length || !groupDay) {
      setLed("--:--");
      if (label) label.textContent = "No classes on the board";
      if (next) next.textContent = "";
      if (sr) sr.textContent = "No classes on the board.";
      if (picks) picks.replaceChildren();
      return;
    }

    const startMin = Number(group[0].dataset.start);
    const heading = groupDay.dataset.heading ?? "";
    const isToday = groupDay.classList.contains("is-today");
    const when = isToday ? "today" : heading === "Tomorrow" ? "tomorrow" : heading;
    if (isToday) {
      const wait = startMin * 60 - now.seconds;
      setLed(countdown(wait));
      if (label) label.textContent = "Next class starts in";
      if (sr) sr.textContent = `Next class today at ${clock(startMin)} PM, in ${inWords(Math.ceil(wait / 60))}.`;
    } else {
      setLed(clock(startMin));
      if (label) label.textContent = `Next class ${when} at`;
      if (sr) sr.textContent = `Next class ${when} at ${clock(startMin)} PM.`;
    }

    const key = group.map((row) => row.id).join("|");
    if (key !== lastGroupKey) {
      lastGroupKey = key;
      if (next) {
        next.textContent =
          group.length > 1
            ? `${isToday ? `${clock(startMin)} PM, ` : ""}${group.length} classes to pick from`
            : `${isToday ? `${clock(startMin)} PM, ` : ""}${group[0].dataset.name}, ${group[0].dataset.club}`;
      }
      if (picks) {
        picks.replaceChildren(
          ...group.map((row) => {
            const item = document.createElement("li");
            const link = document.createElement("a");
            link.className = `pick m-${row.dataset.modality}`;
            link.href = `#${row.id}`;
            link.textContent = row.dataset.name ?? "";
            item.append(link);
            return item;
          }),
        );
      }
    }
  }

  tick();
  setInterval(tick, 1000);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden || !root) return;
    if (Date.now() - Date.parse(root.dataset.generated ?? "") > STALE_MS) location.reload();
    else tick();
  });
</script>

<style is:global>
  :root {
    --wo-canvas: #f2f4f6;
    --wo-ink: #15181c;
    --wo-muted: #57606a;
    --wo-panel: #121417;
    --wo-led: #ff3b2f;
    --wo-courtside: #1d325c;
    --m-strength: #d22a22;
    --m-pilates: #2360d0;
    --m-yoga: #0d8452;
    --m-cardio: #f4b400;
    --m-court: #c6e03a;
    --m-swim: #0a7f99;
    --m-other: #3a4048;
  }
  html {
    scroll-padding-top: 64px;
  }
  body {
    background: var(--wo-canvas);
    color: var(--wo-ink);
    font-family: "Cabin Variable", "Cabin", system-ui, sans-serif;
    margin: 0;
  }
  /* Modality colors and clock picks are global: the script rebuilds the picks. */
  .m-strength { --m-color: var(--m-strength); --m-text: #fff; }
  .m-pilates { --m-color: var(--m-pilates); --m-text: #fff; }
  .m-yoga { --m-color: var(--m-yoga); --m-text: #fff; }
  .m-cardio { --m-color: var(--m-cardio); --m-text: var(--wo-ink); }
  .m-court { --m-color: var(--m-court); --m-text: var(--wo-ink); }
  .m-swim { --m-color: var(--m-swim); --m-text: #fff; }
  .m-other { --m-color: var(--m-other); --m-text: #fff; }
  .pick {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 11px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    color: var(--m-text);
    background: var(--m-color);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<style>
  .wo {
    --display: "Big Shoulders Variable", "Arial Narrow", sans-serif;
    width: min(100% - 28px, 1120px);
    margin: 0 auto;
    padding: 10px 0 48px;
  }

  /* ── Left column: clock, childcare ───────────────────────────── */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 40px;
  }
  .updated {
    font-size: 13px;
    color: var(--wo-muted);
  }

  .clock {
    margin-top: 6px;
    padding: 9px;
    border-radius: 26px;
    background: linear-gradient(160deg, #2b2f35, #0d0f11);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08) inset, 0 18px 36px -22px rgba(21, 24, 28, 0.7);
  }
  .clock-face {
    container-type: inline-size;
    border-radius: 18px;
    background: var(--wo-panel);
    padding: 18px 18px 16px;
    color: #f4f5f6;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
  }
  .clock-title {
    font: 850 clamp(40px, 11vw, 54px) / 0.9 var(--display);
    font-variation-settings: "opsz" 72;
    letter-spacing: -0.005em;
    margin: 0;
    color: #fff;
  }
  .clock-clubs {
    margin: 6px 0 0;
    font-size: 14px;
    color: #a3abb3;
  }
  .clock-label {
    margin: 16px 0 0;
    font: 700 19px/1.2 var(--display);
    font-variation-settings: "opsz" 24;
    letter-spacing: 0.02em;
    color: #d7dbdf;
  }
  .led {
    position: relative;
    font-family: "DSEG7 Classic", monospace;
    font-weight: 700;
    font-size: min(25cqi, 128px);
    line-height: 1.12;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .led-ghost {
    position: absolute;
    inset: 0 auto auto 0;
    color: rgba(255, 59, 47, 0.1);
  }
  .led-digits {
    position: relative;
    color: var(--wo-led);
    text-shadow: 0 0 18px rgba(255, 59, 47, 0.55), 0 0 2px rgba(255, 120, 100, 0.9);
  }
  .led-ghost[data-len="7"],
  .led-digits[data-len="7"] {
    font-size: 0.74em;
  }
  .clock-next {
    margin: 6px 0 0;
    font-size: 17px;
    font-weight: 650;
    line-height: 1.35;
  }
  .clock-picks {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
  }
  .care {
    margin: 14px 0 0;
    padding: 12px 16px;
    border: 2px solid var(--wo-ink);
    border-radius: 14px;
    background: #fff3c4;
    box-shadow: 3px 3px 0 var(--wo-ink);
    font-size: 15px;
    line-height: 1.45;
  }
  .care strong {
    font: 800 20px/1 var(--display);
    font-variation-settings: "opsz" 40;
    margin-right: 2px;
  }
  .care a {
    color: inherit;
    font-weight: 700;
    text-underline-offset: 2px;
  }

  /* ── Board: day sections of class tickets ─────────────────────── */
  .board {
    margin-top: 26px;
  }
  .alert {
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 2px solid var(--m-strength);
    border-radius: 12px;
    background: #fff;
    font-size: 15px;
    line-height: 1.45;
  }
  .alert a {
    display: block;
    margin-top: 4px;
    font-weight: 700;
    color: var(--m-strength);
  }
  .day {
    margin: 0 0 28px;
  }
  .day[hidden] {
    display: none;
  }
  .day-head {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 10px;
    padding: 10px 0 8px;
    background: var(--wo-canvas);
  }
  .day-name {
    font: 850 36px/1 var(--display);
    font-variation-settings: "opsz" 60;
  }
  .is-today .day-name {
    font-size: 44px;
  }
  .day-date {
    font-size: 15px;
    font-weight: 700;
    color: var(--wo-muted);
  }
  .day-done {
    margin: 0;
    font-size: 17px;
    font-weight: 650;
  }
  .day-done[hidden] {
    display: none;
  }

  .tickets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .ticket a {
    display: grid;
    grid-template-columns: 84px 1fr;
    min-height: 96px;
    border: 2px solid var(--wo-ink);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    color: var(--wo-ink);
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--wo-ink);
    transition: transform 80ms ease, box-shadow 80ms ease;
  }
  .ticket a:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--wo-ink);
  }
  .t-time {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2px;
    padding: 10px 4px;
    background: var(--m-color);
    color: var(--m-text);
    border-right: 2px solid var(--wo-ink);
    font-variant-numeric: tabular-nums;
  }
  .t-start {
    font: 850 36px/0.95 var(--display);
    font-variation-settings: "opsz" 60;
  }
  .t-end {
    font-size: 13px;
