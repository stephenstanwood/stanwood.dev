---
import BaseLayout from "../layouts/BaseLayout.astro";
import PixelTideApp from "../components/PixelTide.tsx";
const title = "Pixel Tide — stanwood.dev";
---

<BaseLayout
  title={title}
  description="Waves of colored pixels wash in and out on a beach. Click to build sandcastles the tide slowly erodes. No winning, just vibes."
  slug="pixel-tide"
  favicon="/favicon-pixel-tide.svg"
  themeColor="#1a1520"
  fontsUrl="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;700&family=Press+Start+2P&display=swap"
  schemaCategory="GameApplication"
>
  <Fragment slot="head">
    <style>

      body {
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
        color: #fef0e0;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background: #1a1520;
      }
      .tide-heading { margin: 28px 0; }
      .tide-heading h1 { font: 700 clamp(21px, 5vw, 30px)/1.5 'Press Start 2P', monospace; color: #f5c6a0; }
      .tide-heading p { margin-top: 12px; font-size: 14px; color: #d0b5a3; }

</style>
  </Fragment>

  <div class="mx-auto max-w-3xl px-6 pt-12 pb-24">
    <!-- Nav -->
    <div class="flex items-center">
      <a href="/" class="retro-back" style="color: #e8956a;">&larr; stanwood.dev</a>
    </div>

    <header class="tide-heading">
      <h1>Pixel Tide</h1>
      <p>Build a sandcastle. Let the waves take it.</p>
    </header>
    <!-- Game -->
    <PixelTideApp client:load />


  </div>
</BaseLayout>
