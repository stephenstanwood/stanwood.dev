---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="TL;DR — stanwood.dev"
  description="Upload a PDF up to 3 MB. Get a plain-English paragraph, bullet points, or a review of possible red flags."
  slug="tldr"
  favicon="/favicon-tldr.svg"
  themeColor="#080a0f"
  fontsUrl="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
  schemaCategory="UtilitiesApplication"
  schemaName="TL;DR"
>
  <Fragment slot="head">
    <style>


      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #080a0f;
        color: #E4E4E7;
        min-height: 100vh;
        position: relative;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .tldr-main { position: relative; z-index: 1; }

      .drop-zone {
        transition: border-color 0.3s, box-shadow 0.3s, background-color 0.3s, transform 0.3s ease;
        border: 2px dashed rgba(0, 212, 255, 0.2);
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.05), inset 0 0 20px rgba(0, 212, 255, 0.02);
      }
      .drop-zone:hover {
        border-color: #00D4FF50;
        box-shadow: 0 0 30px rgba(0, 212, 255, 0.1), inset 0 0 30px rgba(0, 212, 255, 0.03);
      }
      .drop-zone.dragover {
        border-color: #00D4FF;
        background-color: rgba(0, 212, 255, 0.05);
        box-shadow: 0 0 40px rgba(0, 212, 255, 0.2), 0 0 60px rgba(74, 222, 128, 0.1), inset 0 0 40px rgba(0, 212, 255, 0.05);
        transform: scale(1.02);
      }
      .drop-zone.compact {
        padding-top: 2rem;
        padding-bottom: 2rem;
      }
      .drop-zone.compact svg {
        height: 1.5rem;
        width: 1.5rem;
      }

      .fade-in {
        animation: fadeIn 0.4s ease-out;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .mono { font-family: 'JetBrains Mono', monospace; }
      .format-toggle {
        display: inline-flex;
        border: 1px solid rgba(0, 212, 255, 0.15);
        border-radius: 8px;
        overflow: hidden;
        background: #0d1117;
      }
      .format-btn {
        padding: 6px 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.06em;
        color: #71717A;
        background: transparent;
        border: none;
        cursor: pointer;
        transition: color 0.15s, background 0.15s;
      }
      .format-btn:hover { color: #E4E4E7; }
      .format-btn.active {
        color: #00D4FF;
        background: rgba(0, 212, 255, 0.08);
      }
      .summary-bullets {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .summary-bullets li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        font-size: 15px;
        line-height: 1.55;
        color: #E4E4E7;
      }
      .summary-bullets li::before {
        content: '•';
        color: #4ADE80;
        flex-shrink: 0;
        font-size: 16px;
        line-height: 1.45;
      }
      .summary-flags {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .summary-flags li {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        font-size: 14px;
        line-height: 1.55;
        color: #E4E4E7;
        padding: 12px 14px;
        border-radius: 10px;
        background: rgba(239, 68, 68, 0.05);
        border-left: 3px solid rgba(239, 68, 68, 0.5);
      }
      .summary-flags li.is-fact {
        background: rgba(0, 212, 255, 0.04);
        border-left-color: rgba(0, 212, 255, 0.5);
      }
      .summary-flags .flag-icon {
        flex-shrink: 0;
        font-size: 16px;
        line-height: 1.4;
      }
      .summary-flags .flag-body {
        flex: 1;
        min-width: 0;
      }
      .summary-flags .flag-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #fca5a5;
        margin-bottom: 4px;
      }
      .summary-flags li.is-fact .flag-label {
        color: #7dd3fc;
      }
      .summary-flags .flag-text {
        color: #d4d4d8;
        font-size: 14px;
        line-height: 1.55;
      }

      .tldr-note { color: #a1a1aa; font-size: 12px; line-height: 1.7; margin-top: 24px; max-width: 58ch; }
      .format-btn { min-height: 44px; color: #a1a1aa; }
      .drop-zone:hover { border-color: #00d4ff; }


</style>
  </Fragment>

    <div class="tldr-main mx-auto max-w-2xl px-6 pt-16 pb-24">
      <!-- Top bar -->
      <div class="flex items-center">
        <a href="/" class="retro-back">&larr; stanwood.dev</a>
      </div>

      <!-- Header -->
      <header class="mt-8">
        <h1 class="text-5xl font-bold tracking-tight text-white mono">
          TL;DR
        </h1>
        <p class="mt-4 text-[#a1a1aa] leading-relaxed max-w-lg">
          A long PDF. The short version.
        </p>
      </header>

      <!-- Format toggle -->
      <div class="mt-8 flex items-center gap-3 flex-wrap">
        <span class="text-xs text-[#a1a1aa] mono uppercase tracking-widest">output</span>
        <div class="format-toggle" role="group" aria-label="Summary format">
          <button class="format-btn active" aria-pressed="true" data-format="paragraph" id="btnParagraph">paragraph</button>
          <button class="format-btn" aria-pressed="false" data-format="bullets" id="btnBullets">bullets</button>
          <button class="format-btn" aria-pressed="false" data-format="red-flags" id="btnRedFlags">🚩 red flags</button>
        </div>
      </div>

      <!-- Upload zone -->
      <section id="uploadSection" class="mt-6">
        <div
          id="dropZone"
          class="drop-zone relative flex flex-col items-center justify-center rounded-2xl bg-[#0d1117] px-6 py-12 text-center cursor-pointer"
        >
          <div id="uploadPrompt">
            <svg class="mx-auto h-10 w-10 text-[#1e3a4a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m6.75 12-3-3m0 0-3 3m3-3v6m-1.5-15H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            <p class="mt-4 text-sm font-medium text-[#E4E4E7]">
              Drop a PDF here, or click to upload.
            </p>
            <p class="mt-1 text-xs text-[#a1a1aa]">
              Choose a PDF to get started.
            </p>
          </div>

          <!-- Loading state (hidden by default) -->
          <div id="loadingState" class="hidden">
            <p id="fileName" class="text-xs text-[#a1a1aa] mono rounded-full bg-[#131a24] px-3 py-1 inline-block"></p>
            <div class="mt-4 flex flex-col items-center gap-2">
              <span class="text-sm text-[#a1a1aa]" role="status">Reading your PDF…</span>
            </div>
          </div>

          <input
            id="fileInput"
            type="file"
            accept="application/pdf"
            aria-label="Upload PDF file"
            class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
          />
        </div>
      </section>

      <!-- Result -->
      <section id="resultSection" class="mt-8 hidden">
        <div class="fade-in rounded-2xl border-l-4 border-[#4ADE80] bg-[#0d1117] shadow-lg">
          <div class="px-8 py-8">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <h2 id="resultLabel" class="text-xs font-semibold uppercase tracking-widest text-[#4ADE80] mono">
                  Summary
                </h2>
                <span id="wordCount" class="text-[10px] text-[#a1a1aa] mono"></span>
              </div>
              <div class="flex items-center gap-1">
                <button
                  id="copyBtn"
                  class="rounded-lg px-3 py-1.5 text-xs font-medium text-[#a1a1aa] hover:text-[#00D4FF] hover:bg-[#131a24] transition-colors mono"
                >
                  copy
                </button>
                <button
                  id="downloadBtn"
                  class="rounded-lg px-3 py-1.5 text-xs font-medium text-[#a1a1aa] hover:text-[#4ADE80] hover:bg-[#131a24] transition-colors mono"
                  title="Download as .txt"
                >
                  download
                </button>
              </div>
            </div>
            <div id="summaryContent"></div>
          </div>
        </div>
      </section>

      <!-- Error -->
      <div id="errorMsg" class="mt-6 hidden">
        <p class="text-sm text-[#f87171] text-center mono"></p>
      </div>

      <p class="tldr-note">PDFs up to 3 MB. Sent to Anthropic for processing; this app doesn’t save your file. AI can miss details — check the original before signing.</p>
    </div>

    <script>
      const dropZone = document.getElementById("dropZone")!;
      const fileInput = document.getElementById("fileInput") as HTMLInputElement;
      const uploadPrompt = document.getElementById("uploadPrompt")!;
      const uploadSection = document.getElementById("uploadSection")!;
      const loadingState = document.getElementById("loadingState")!;
      const fileNameEl = document.getElementById("fileName")!;
      const resultSection = document.getElementById("resultSection")!;
      const summaryContent = document.getElementById("summaryContent")!;
      const copyBtn = document.getElementById("copyBtn")!;
      const downloadBtn = document.getElementById("downloadBtn")!;
      const wordCount = document.getElementById("wordCount")!;
      const resultLabel = document.getElementById("resultLabel")!;
      const errorMsg = document.getElementById("errorMsg")!;
      const btnParagraph = document.getElementById("btnParagraph")!;
      const btnBullets = document.getElementById("btnBullets")!;
      const btnRedFlags = document.getElementById("btnRedFlags")!;

      type Format = "paragraph" | "bullets" | "red-flags";
      let selectedFormat: Format = "paragraph";
      let lastSummaryText = "";

      const formatBtns: Record<Format, HTMLElement> = {
        paragraph: btnParagraph,
        bullets: btnBullets,
        "red-flags": btnRedFlags,
      };

      function setFormat(f: Format) {
        selectedFormat = f;
        (Object.keys(formatBtns) as Format[]).forEach((key) => {
          formatBtns[key].classList.toggle("active", key === f);
          formatBtns[key].setAttribute("aria-pressed", String(key === f));
        });
      }

      btnParagraph.addEventListener("click", () => setFormat("paragraph"));
      btnBullets.addEventListener("click", () => setFormat("bullets"));
      btnRedFlags.addEventListener("click", () => setFormat("red-flags"));

      function showError(msg: string) {
        errorMsg.querySelector("p")!.textContent = msg;
        errorMsg.classList.remove("hidden");
      }

      function clearError() {
        errorMsg.classList.add("hidden");
      }

      function setLoading(loading: boolean, name = "") {
        if (loading) {
          uploadPrompt.classList.add("hidden");
          loadingState.classList.remove("hidden");
          fileNameEl.textContent = name;
          fileInput.disabled = true;
          resultSection.classList.add("hidden");
          // Reset drop zone to full size during loading
          dropZone.classList.remove("compact");
          // Move upload section back to top
          const header = document.querySelector("header")!;
          header.after(uploadSection);
        } else {
          uploadPrompt.classList.remove("hidden");
          loadingState.classList.add("hidden");
          fileInput.disabled = false;
        }
      }

      function fileToBase64(file: File): Promise<string> {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = reader.result as string;
            resolve(result.split(",")[1]); // strip data:...;base64, prefix
          };
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      async function handleFile(file: File) {
        clearError();

        if (file.type !== "application/pdf") {
          showError("That doesn't look like a PDF. Please try a .pdf file.");
          return;
        }

        if (file.size > 3 * 1024 * 1024) {
          showError("That file is too large (max 3 MB).");
          return;
        }

        setLoading(true, file.name);

        try {
          const base64 = await fileToBase64(file);

          const res = await fetch("/api/summarize-pdf", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ pdf: base64, name: file.name, format: selectedFormat }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || "Something went wrong");
          }


          setLoading(false);

          // Render result
          lastSummaryText = data.summary;
          resultSection.classList.remove("hidden");
          const card = resultSection.querySelector(".fade-in")!;
          card.classList.remove("fade-in");
          void (card as HTMLElement).offsetWidth;
          card.classList.add("fade-in");

          if (data.format === "bullets") {
            const lines = data.summary
              .split("\n")
              .map((l: string) => l.replace(/^[•\-]\s*/, "").trim())
              .filter(Boolean);
            const ul = document.createElement("ul");
            ul.className = "summary-bullets";
            lines.forEach((line: string) => {
              const li = document.createElement("li");
              li.textContent = line;
              ul.appendChild(li);
            });
            summaryContent.innerHTML = "";
            summaryContent.appendChild(ul);
          } else if (data.format === "red-flags") {
            const lines = (data.summary as string)
              .split("\n")
              .map((l) => l.trim())
              .filter(Boolean);
            const ul = document.createElement("ul");
            ul.className = "summary-flags";
            lines.forEach((line) => {
              // Match leading icon (🚩 or 📌), then optional separator
              const iconMatch = line.match(/^(🚩|📌)\s*(.*)$/u);
              const isFact = iconMatch?.[1] === "📌";
              const rest = iconMatch?.[2] ?? line;
              // Split on first em-dash, en-dash, hyphen-with-spaces, or colon
              const splitMatch = rest.match(/^(.+?)\s*(?:—|–|--|-|:)\s+(.+)$/);
              const label = splitMatch ? splitMatch[1].trim() : "";
              const text = splitMatch ? splitMatch[2].trim() : rest;

              const li = document.createElement("li");
              if (isFact) li.classList.add("is-fact");

              const icon = document.createElement("span");
              icon.className = "flag-icon";
              icon.textContent = isFact ? "📌" : "🚩";
              li.appendChild(icon);

              const body = document.createElement("div");
              body.className = "flag-body";
              if (label) {
                const lbl = document.createElement("span");
                lbl.className = "flag-label";
                lbl.textContent = label;
                body.appendChild(lbl);
              }
              const txt = document.createElement("span");
              txt.className = "flag-text";
              txt.textContent = text;
              body.appendChild(txt);

              li.appendChild(body);
              ul.appendChild(li);
            });
            summaryContent.innerHTML = "";
            summaryContent.appendChild(ul);
          } else {
            const p = document.createElement("p");
            p.className = "text-base leading-relaxed text-[#E4E4E7]";
            p.textContent = data.summary;
            summaryContent.innerHTML = "";
            summaryContent.appendChild(p);
          }

          // Update label + word count
          if (data.format === "red-flags") {
            // If output starts with 📌, this is benign — call it "Key Facts" instead
            const isBenign = data.summary.trimStart().startsWith("📌");
            resultLabel.textContent = isBenign ? "Key Facts" : "Red Flags";
            resultLabel.className = isBenign
              ? "text-xs font-semibold uppercase tracking-widest text-[#7dd3fc] mono"
              : "text-xs font-semibold uppercase tracking-widest text-[#fca5a5] mono";
          } else {
            resultLabel.textContent = "Summary";
            resultLabel.className = "text-xs font-semibold uppercase tracking-widest text-[#4ADE80] mono";
          }
          const words = data.summary.trim().split(/\s+/).filter(Boolean).length;
          wordCount.textContent = `${words} words`;

          // Move drop zone below the result and make it compact
          resultSection.after(uploadSection);
          dropZone.classList.add("compact");
        } catch (err) {
          setLoading(false);
          showError(
            err instanceof Error && err.message
              ? err.message
              : "Failed to summarize. Please try again.",
          );
        }
      }

      // Drag & drop
      dropZone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropZone.classList.add("dragover");
      });

      dropZone.addEventListener("dragleave", () => {
        dropZone.classList.remove("dragover");
      });

      dropZone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropZone.classList.remove("dragover");
        const file = e.dataTransfer?.files[0];
        if (file) handleFile(file);
      });

      // File input
      fileInput.addEventListener("change", () => {
        const file = fileInput.files?.[0];
        if (file) handleFile(file);
        fileInput.value = "";
      });

      // Download summary as .txt
      downloadBtn.addEventListener("click", () => {
        const text = lastSummaryText;
        if (!text) return;
        const blob = new Blob([text], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "tldr-summary.txt";
        a.click();
        URL.revokeObjectURL(url);
        downloadBtn.textContent = "saved!";
        downloadBtn.style.color = "#4ADE80";
        setTimeout(() => {
          downloadBtn.textContent = "download";
          downloadBtn.style.color = "";
        }, 1500);
      });

      // Copy — grab the plain text
      copyBtn.addEventListener("click", async () => {
        const text = lastSummaryText;
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = "copied!";
        copyBtn.style.color = "#4ADE80";
        copyBtn.style.background = "rgba(74, 222, 128, 0.1)";
        setTimeout(() => {
          copyBtn.textContent = "copy";
          copyBtn.style.color = "";
          copyBtn.style.background = "";
        }, 1500);
      });
    </script>
</BaseLayout>
