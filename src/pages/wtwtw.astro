---
import BaseLayout from "../layouts/BaseLayout.astro";
import WTWTW from "../components/WTWTW.tsx";

const title = "WTWTW — stanwood.dev";
const description =
  "What to watch this week — one game worth watching each night, ranked by your teams.";
---

<BaseLayout
  title={title}
  description={description}
  slug="wtwtw"
  favicon="/favicon-wtwtw.svg"
  themeColor="#0a1628"
  fontsUrl="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
  schemaCategory="SportsApplication"
  schemaName="What To Watch This Week"
>
  <Fragment slot="head">
    <style>
      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #0a1628;
        min-height: 100vh;
        color: #fff;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body::before {
        content: '';
        position: fixed;
        top: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: 120%;
        height: 60%;
        background: radial-gradient(ellipse, rgba(29, 66, 138, 0.15) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      .wtwtw-main {
        position: relative;
        z-index: 1;
      }

      .oswald { font-family: 'Oswald', sans-serif; }

      @keyframes activePulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }
    </style>
  </Fragment>

  <div class="wtwtw-main mx-auto max-w-2xl px-6 pt-16 pb-24">
    <a href="/" class="retro-back">&larr; stanwood.dev</a>

    <header class="mt-10">
      <h1 class="oswald text-5xl font-bold uppercase tracking-tight text-white sm:text-6xl">
        WTWTW
      </h1>
      <p class="mt-2 text-lg text-white/70">
        What to watch this week &mdash; your teams, your schedule.
      </p>
    </header>

    <WTWTW client:load />
  </div>
</BaseLayout>
