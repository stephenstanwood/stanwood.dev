                  <span class="listing-still">
                    <img src={stillUrl(v)} alt="" width="320" height="180" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
                  </span>
                  <span class="listing-body">
                    <span class="listing-kicker">
                      <span class="listing-num" aria-hidden="true"></span>
                      <span class="listing-lane">{topicLabel(v)}</span>
                      <span class="listing-runtime">{formatRuntime(v.duration)}</span>
                    </span>
                    <span class="listing-headline">{listingHeadline(v)}</span>
                    {v.editorial_reason && <span class="listing-blurb">{v.editorial_reason}</span>}
                    <span class="listing-credit">
                      <span class="listing-creator">{v.channel_title}</span>
                      {notes.map((note) => <span>{note}</span>)}
                    </span>
                  </span>
                </a>
                <div class="listing-marks">
                  <button class="listing-mark like" data-mark-broader={v.id} data-action="like" title={v.series_key ? 'follow this series' : 'more like this'} aria-label={v.series_key ? 'Follow this series' : 'More like this'}>✓</button>
                  <button class="listing-mark" data-mark-broader={v.id} data-action="pass" title={v.series_key ? 'hide this series' : 'not for me'} aria-label={v.series_key ? 'Hide this series' : 'Not for me'}>×</button>
