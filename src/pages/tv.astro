    .schedule-time { color: #555; font-size: 0.7rem; letter-spacing: 0.03em; }
    .schedule-time.live {
      color: var(--hot);
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }
    @media (max-width: 900px) {
      .listings { grid-template-columns: 1fr; }
    }
    @media (pointer: coarse) {
      .listing-marks { opacity: 1; }
      .listing-mark { min-width: 44px; height: 44px; font-size: 0.9rem; }
      .listing-kicker { padding-right: 6.5rem; }
