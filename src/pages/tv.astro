      /* Marks tuck under the still instead of taking a row of their own. */
      .listing-marks { top: calc(.8rem + 58.5px + .6rem); right: auto; left: 0; opacity: 1; }
      .listing.is-lead .listing-marks { position: static; justify-content: flex-end; padding: 0 1rem .9rem; }
