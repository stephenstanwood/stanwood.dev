            );
          })}
          {SHOW_SDSN_CLASSIC && (
            <li class="listing classic-listing" id="sdsn-classic-card" hidden>
              <a class="listing-link" href="https://www.youtube.com/playlist?list=PLk7eG7txNmA0aOww_rvQJy49xGEZe_U5d" target="_blank" rel="noopener">
