    {internetPicks.length > 0 && (
      <section class="internet-section" aria-labelledby="internet-title" data-built-at={broader.built_at ?? ''}>
        <div class="listings-head">
          <h2 class="section-title" id="internet-title">around the internet</h2>
          <a
            class="play-all"
            id="play-all"
            href={playAllUrl(internetPicks.map((v) => v.id))}
