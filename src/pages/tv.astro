        >
          {internetListings.map((v, index) => {
            const inEdition = index < internetPicks.length;
            const notes = listingNotes(v);
            return (
              <li
                class:list={['listing', { 'is-lead': index === 0 }]}
                hidden={!inEdition}
                data-state={inEdition ? 'shown' : 'reserve'}
                data-broader-id={v.id}
                data-published-at={v.published_at}
                data-source-key={sourceKey(v)}
                data-topic={topicKey(v)}
                data-theme={v.theme || ''}
