---
// Sports rails + Around the internet: a nightly edition of TV-style YouTube
// listings (scripts/tv-queue). Listings are launchpads that open on YouTube.
// The Stanford queue below is parked.

import fs from 'node:fs';
import path from 'node:path';
import LiveSports from '../components/LiveSports.tsx';
import TodaySports from '../components/TodaySports.tsx';
import ReplaySports from '../components/ReplaySports.tsx';
import { TV_TEAM_KEYS } from '../lib/tvReplays';
import { PACIFIC_TZ } from '../lib/dateFormat';
import { isEnglishVideo } from '../lib/tvLanguage';
import {
  chooseInternetPicks, eligibleInternetVideo, formatRuntime, listingHeadline, playAllUrl, sourceKey, stillUrl,
  topicKey, topicLabel, INTERNET_MAX_PER_SOURCE,
} from '../lib/tvInternet';
import { jsonForScriptTag } from '../lib/htmlUtils';
import { pluralize } from '../lib/text';
import { compactAge, compactDuration } from '../lib/tvFormat';

interface QueueVideo {
  id: string;
  title: string;
  url?: string;
  duration: number;
  published_at: string;
  lecture_num: number | null;
}

interface Series {
  key: string;
  display_name: string;
  best_score: number;
  video_count: number;
  video_ids: string[];
}

interface BroaderVideo {
  id: string;
  title: string;
  url: string;
  duration: number;
  published_at: string;
  channel_title: string;
  channel_id?: string;
  channel_handle?: string;
  headline?: string;
  still?: string;
  start_at?: number;
  ad_seconds?: number;
  series_key?: string;
  episode_number?: number;
  exploration?: boolean;
  categories?: string[];
  score?: number;
  rank_score?: number;
  feedback_mult?: number;
  source?: 'trusted' | 'discovery';
  editorial_score?: number;
  editorial_reason?: string;
  topic?: string;
  theme?: string;
  title_categories?: string[];
  language?: string;
  default_audio_language?: string;
  default_language?: string;
}

interface YouTubeData {
  queue: QueueVideo[];
  series: Series[];
  built_at: string | null;
}

interface BroaderData {
  queue: BroaderVideo[];
  pool: BroaderVideo[];
  built_at: string | null;
  channel_count: number;
  discovery_query_count?: number;
  discovery_candidate_count?: number;
  editorial_applied?: boolean;
  series_episodes?: Record<string, BroaderVideo[]>;
}

const dataPath = path.join(process.cwd(), 'public', 'yt', 'videos.json');
let data: YouTubeData = { queue: [], series: [], built_at: null };
if (fs.existsSync(dataPath)) {
  data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
}

const broaderPath = path.join(process.cwd(), 'public', 'yt', 'broader.json');
let broader: BroaderData = { queue: [], pool: [], built_at: null, channel_count: 0 };
if (fs.existsSync(broaderPath)) {
  broader = JSON.parse(fs.readFileSync(broaderPath, 'utf-8'));
}

// Channels permanently screened out of "around the internet" — never render
// these, even if the nightly pipeline surfaces them. Matched on channel_id
// (stable) or @handle (case-insensitive). The Mini's build_broader.py drops
// them at the source too; this is the repo-side guarantee that survives any
// pipeline regression.
const BLOCKED_CHANNEL_IDS = new Set<string>([
  'UCbRP3c757lWg9M-U7TyEkXA', // Theo - t3.gg
  'UCrqM0Ym_NbK1fqeQG2VIohg', // Tsoding Daily
]);
const BLOCKED_CHANNEL_HANDLES = new Set<string>([
  '@t3dotgg', // Theo - t3.gg
  '@tsodingdaily', // Tsoding Daily
]);
function isBlockedBroader(v: BroaderVideo): boolean {
  if (v.channel_id && BLOCKED_CHANNEL_IDS.has(v.channel_id)) return true;
  const handle = v.channel_handle?.toLowerCase();
  return handle ? BLOCKED_CHANNEL_HANDLES.has(handle) : false;
}

const byRecency = (a: { published_at: string }, b: { published_at: string }) =>
  new Date(b.published_at).getTime() - new Date(a.published_at).getTime();

// CLEANUP-FLAG: with this off, the "stanford talks" sections below (~180 lines
// of markup, plus the topSeries/restSeries prep) never render. The stanford
// *state* is still live — renderFollowedSeries() emits [data-hide-stanford]
// buttons and hideStanford() still posts marks to the Mini — so deleting the
// dead markup means untangling those two halves, not a mechanical removal.
const SHOW_STANFORD_TALKS = false;
// Temporarily parked; flip this back on to restore the pinned rewatch card.
const SHOW_SDSN_CLASSIC = false;
const AUTO_UNLOCK_IN_DEV = import.meta.env.DEV;
const INTERNET_MAX_PICKS = 20;
// The edition is judged as of its own build, so a stalled builder leaves the
// last edition up (flagged as stale on the page) instead of quietly emptying it.
const editionTime = broader.built_at ? Date.parse(broader.built_at) : Date.now();
const seenBroaderIds = new Set<string>();
const inventory = [...(broader.queue ?? []), ...(broader.pool ?? [])].filter((video) => {
  if (!isEnglishVideo(video) || isBlockedBroader(video) || seenBroaderIds.has(video.id)) return false;
  seenBroaderIds.add(video.id);
  return true;
});
// The visible edition is the editor's edit only; reserve picks wait offstage
// and step in, in rank order, when a listing is marked.
const editIds = new Set((broader.queue ?? []).map((video) => video.id));
const internetPicks = chooseInternetPicks(inventory.filter((video) => editIds.has(video.id)), INTERNET_MAX_PICKS, editionTime);
const internetPickIds = new Set(internetPicks.map((video) => video.id));
const internetReserve = inventory.filter((video) => !internetPickIds.has(video.id) && eligibleInternetVideo(video, editionTime));
const internetListings = [...internetPicks, ...internetReserve];
const editionSeconds = internetPicks.reduce((sum, video) => sum + (video.duration || 0), 0);
const editionLabel = broader.built_at
  ? `${new Date(broader.built_at).toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', timeZone: PACIFIC_TZ })} edition`
  : 'edition pending';

function fmtClock(seconds: number) {
  const m = Math.floor(seconds / 60);
  return `${m}:${String(seconds % 60).padStart(2, '0')}`;
}

function listingNotes(v: BroaderVideo): string[] {
  const notes: string[] = [];
  if (v.start_at) notes.push(`starts at ${fmtClock(v.start_at)}`);
  const adSeconds = v.ad_seconds ?? 0;
  if (adSeconds >= 45) notes.push(`${Math.round(adSeconds / 60)} min sponsor read`);
  return notes;
}

const topSeries = data.series?.[0] ?? null;
const restSeries = (data.series ?? []).slice(1);

// Series where videos are independent (seminars, talk series) — show newest first.
// Sequential courses (lectures 1, 2, 3...) stay in original order.
const REVERSE_ORDER_KEYS = new Set(['CS547', 'Robotics Seminar']);

function seriesVideos(series: Series): QueueVideo[] {
  const vids = series.video_ids
    .map((id) => data.queue.find((v) => v.id === id))
    .filter((v): v is QueueVideo => v !== undefined);
  if (REVERSE_ORDER_KEYS.has(series.key)) {
    return [...vids].sort(byRecency);
  }
  return vids;
}
---

<html lang="en" class:list={{ 'yt-unlocked': AUTO_UNLOCK_IN_DEV }}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>TV Queue · stanwood.dev</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;600&family=Permanent+Marker&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('yt-gate-v1') === 'meow') {
          document.documentElement.classList.add('yt-unlocked');
        }
      } catch {}
    })();
    // Frame-friendly: full reload every 20 min so static content (videos, broader)
    // stays fresh and the live strip resyncs even if the tab has been backgrounded.
    setTimeout(function () { window.location.reload(); }, 20 * 60 * 1000);
  </script>
  <style is:global>
    :root {
      --bg: #f2f4f7;
      --ink: #1a1a1a;
      --paper: #ffffff;
      --hot: #ff3b30;
      --cool: #0a84ff;
      --cool-soft: #e5edf7;
      --lime: #b8e986;
      --yellow: #ffd86b;
      --muted: #666;
      --line: #c7ccd4;
      --border: 3px solid var(--ink);
      --shadow: 6px 6px 0 var(--ink);
    }
    * { box-sizing: border-box; }
    html { background: var(--bg); }
    body {
      margin: 0;
      padding: 2rem 1rem;
      min-height: 100vh;
      background: var(--bg);
      color: var(--ink);
      font-family: 'Space Mono', monospace;
      font-size: 15px;
      line-height: 1.5;
    }
    button, input { font: inherit; }
    button:focus-visible, a:focus-visible, input:focus-visible {
      outline: 3px solid var(--yellow);
      outline-offset: 3px;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .wrap { max-width: 1100px; margin: 0 auto; }

    /* Password gate */
    html:not(.yt-unlocked) .wrap { display: none; }
    html.yt-unlocked #yt-gate { display: none; }
    #yt-gate {
      max-width: 360px;
      margin: 4rem auto;
      padding: 2rem 1.5rem;
      background: var(--paper);
      border: var(--border);
      box-shadow: var(--shadow);
      text-align: center;
    }
    #yt-gate h2 {
      font-family: 'Permanent Marker', cursive;
      font-size: 1.6rem;
      margin: 0 0 1rem;
    }
    #yt-gate input {
      width: 100%;
      padding: .6rem .8rem;
      border: var(--border);
      font-family: 'Space Mono', monospace;
      font-size: 1rem;
      background: var(--bg);
      color: var(--ink);
    }
    #yt-gate input:focus { outline: none; background: var(--paper); }
    #yt-gate.shake { animation: gate-shake 0.3s; }
    @keyframes gate-shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      75% { transform: translateX(8px); }
    }
    h1 {
      font-family: 'Permanent Marker', cursive;
      font-size: clamp(2.4rem, 6vw, 3.6rem);
      margin: 0 0 .25rem;
      line-height: 1;
      letter-spacing: -0.02em;
    }
    .subtitle {
      font-size: 0.85rem;
      color: var(--muted);
      margin: 0 0 2rem;
    }
    .subtitle a { color: var(--cool); }

    h2 {
      font-family: 'Permanent Marker', cursive;
      font-size: 1.8rem;
      margin: 2.5rem 0 .5rem;
    }
    h2:first-of-type { margin-top: 0; }
    h2.section-title {
      font-size: clamp(2.4rem, 6vw, 3.6rem);
      line-height: 1;
      letter-spacing: -0.02em;
      margin: 2.5rem 0 2rem;
    }

    .series {
      border: var(--border);
      background: var(--paper);
      box-shadow: var(--shadow);
      margin-bottom: 1.5rem;
      padding: 1rem 1.25rem;
    }
    .series[hidden] { display: none; }
    .series-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: .5rem;
      flex-wrap: wrap;
    }
    .series-name {
      font-family: 'Permanent Marker', cursive;
      font-size: 1.3rem;
    }
    .series-meta { font-size: 0.75rem; color: #666; }
    .score-chip {
      display: inline-block;
      background: var(--lime);
      border: 2px solid var(--ink);
      padding: 1px 6px;
      font-size: 0.7rem;
      font-weight: 700;
      margin-left: .5rem;
    }
    .score-chip.low { background: #fff; color: #999; }
    ul.videos {
      list-style: none;
      margin: 0;
      padding: 0 .25rem 0 0;
      max-height: 220px;
      overflow-y: auto;
      -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 28px), transparent 100%);
              mask-image: linear-gradient(to bottom, #000 calc(100% - 28px), transparent 100%);
    }
    ul.videos::-webkit-scrollbar { width: 8px; }
    ul.videos::-webkit-scrollbar-track { background: transparent; }
    ul.videos::-webkit-scrollbar-thumb {
      background: #c8ced6;
      border-radius: 4px;
    }
    ul.videos::-webkit-scrollbar-thumb:hover { background: #aeb6c1; }
    ul.videos li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: .5rem 0;
      border-top: 1px dashed #bbbfc5;
      cursor: pointer;
    }
    ul.videos li:first-child { border-top: none; }
    ul.videos li:hover { background: #e1e9f3; }
    ul.videos li.watched,
    ul.videos li.hidden-row { display: none; }
    .vtitle { flex: 1; font-size: 0.9rem; }
    .vmeta { font-size: 0.75rem; color: #666; white-space: nowrap; }
    .row-btns { display: flex; gap: 4px; }
    .mark-btn {
      border: 1px solid #999;
      background: transparent;
      font-size: 0.7rem;
      padding: 2px 6px;
      cursor: pointer;
      font-family: inherit;
    }
    .mark-btn:hover { background: var(--hot); color: var(--paper); border-color: var(--hot); }
    /* Touch devices need bigger tap targets than the dense desktop list */
    @media (pointer: coarse) {
      .mark-btn { padding: 10px 14px; font-size: 0.85rem; }
    }

    .empty {
      padding: 2rem;
      text-align: center;
      background: var(--paper);
      border: var(--border);
    }
    /* Around the internet: one nightly edition of TV-style listings */
    .internet-section { margin-top: 0; }
    .listings-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: .75rem 1.5rem;
      margin: 2.5rem 0 .4rem;
    }
    .listings-head h2.section-title { margin: 0; }
    .play-all {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .45rem .8rem;
      background: var(--paper);
      border: var(--border);
      box-shadow: 4px 4px 0 var(--ink);
      color: var(--ink);
      font-size: .78rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      transition: transform .05s ease, box-shadow .05s ease, background .1s ease;
    }
    .play-all:hover {
      background: var(--lime);
      transform: translate(-1px, -1px);
      box-shadow: 5px 5px 0 var(--ink);
    }
    .internet-meta {
      display: flex;
      flex-wrap: wrap;
      margin: 0 0 1.5rem;
      color: var(--muted);
      font-size: .72rem;
    }
    .internet-meta > span + span::before { content: ' · '; white-space: pre; }
    .internet-meta .edition-stale { color: var(--hot); font-weight: 700; }
    .internet-meta .edition-stale[hidden] { display: none; }

    .listings {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.25rem;
      counter-reset: listing;
    }
    .listing {
      --lane: #8e8e93;
      position: relative;
      min-width: 0;
      border-top: 2px solid var(--ink);
      counter-increment: listing;
    }
    .listing[hidden] { display: none; }
    /* Riso-ish inks, one per lane. */
    .listing[data-topic="ai_practice"] { --lane: #00a95c; }
    .listing[data-topic="dev_world"] { --lane: #ff6c2f; }
    .listing[data-topic="war_stories"] { --lane: #f15060; }
    .listing[data-topic="how_it_works"] { --lane: #0078bf; }
    .listing[data-topic="software_craft"] { --lane: #765ba7; }
    .listing[data-topic="design"] { --lane: #ff48b0; }
    .listing[data-topic="product"] { --lane: #bb8b41; }
    .listing[data-topic="visual_computing"] { --lane: #00838a; }
    .listing[data-topic="tech_history"] { --lane: #925f52; }
    .listing[data-topic="public_tech"] { --lane: #3d5588; }
    .listing[data-topic="making"] { --lane: #67b346; }
    .listing-link {
      display: grid;
      grid-template-columns: 168px minmax(0, 1fr);
      gap: 1rem;
      padding: 1rem 0 1.15rem;
      color: inherit;
      text-decoration: none;
    }
    .listing-still {
      position: relative;
      align-self: start;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border: 2px solid var(--ink);
      background: var(--lane);
      isolation: isolate;
    }
    .listing-still img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.12) brightness(1.06);
      transition: filter .2s ease;
    }
    /* Duotone: the lane's ink in the shadows, paper in the highlights. Real
       colour comes back on hover or focus. */
    .listing-still::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--lane);
      mix-blend-mode: screen;
      transition: opacity .2s ease;
    }
    .listing-link:hover .listing-still img,
    .listing-link:focus-visible .listing-still img { filter: none; }
    .listing-link:hover .listing-still::after,
    .listing-link:focus-visible .listing-still::after { opacity: 0; }
    .listing-body {
      display: flex;
      flex-direction: column;
      gap: .3rem;
      min-width: 0;
    }
    .listing-kicker {
      display: flex;
      align-items: center;
      gap: .5rem;
      padding-right: 4.25rem;
      font-size: .66rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .listing-num::before { content: counter(listing, decimal-leading-zero); }
    .listing-lane {
      padding: 0 .35rem;
      border: 1.5px solid var(--ink);
      background: color-mix(in srgb, var(--lane) 30%, var(--paper));
      white-space: nowrap;
    }
    .listing-runtime { color: var(--muted); white-space: nowrap; }
    .listing-headline {
      font-size: .98rem;
      font-weight: 700;
      line-height: 1.3;
      text-wrap: pretty;
    }
    .listing-link:hover .listing-headline {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }
    .listing-blurb {
      font-family: 'Cabin', sans-serif;
      font-size: .92rem;
      line-height: 1.4;
      color: #3f3f3f;
    }
    .listing-credit { font-size: .7rem; color: var(--muted); }
    .listing-credit > span + span::before { content: ' · '; white-space: pre; }
    .listing-creator { color: var(--ink); font-weight: 700; }
    .listing-marks {
      position: absolute;
      top: .8rem;
      right: 0;
      z-index: 2;
      display: flex;
      gap: 4px;
      opacity: 0;
      transition: opacity .1s ease;
    }
    .listing:hover .listing-marks,
    .listing:focus-within .listing-marks { opacity: 1; }
    .listing-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 28px;
      height: 25px;
      padding: 1px 6px;
      background: var(--paper);
      border: 2px solid var(--ink);
      color: var(--ink);
      font-size: .75rem;
      font-weight: 700;
      cursor: pointer;
    }
    .listing-mark:hover { background: var(--hot); color: var(--paper); }
    .listing-mark.like:hover { background: var(--lime); color: var(--ink); }

    /* The lead listing becomes a feature box across the full width. */
    .listing.is-lead {
      grid-column: 1 / -1;
      margin: 0 0 1.75rem;
      background: var(--paper);
      border: var(--border);
      box-shadow: var(--shadow);
    }
    .listing.is-lead .listing-link {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 1.5rem;
      padding: 0;
    }
    .listing.is-lead .listing-still {
      align-self: stretch;
      border: 0;
      border-right: var(--border);
    }
    .listing.is-lead .listing-still::before {
      content: 'start here';
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      padding: 1px 6px;
      background: var(--yellow);
      border: 2px solid var(--ink);
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
    .listing.is-lead .listing-body {
      justify-content: center;
      gap: .55rem;
      padding: 1.4rem 1.4rem 1.4rem 0;
    }
    .listing.is-lead .listing-headline {
      font-size: clamp(1.2rem, 2.1vw, 1.55rem);
      line-height: 1.2;
    }
    .listing.is-lead .listing-blurb { font-size: 1.04rem; }
    .listing.is-lead .listing-marks { top: 1.1rem; right: 1.1rem; }
    .listing.is-lead .listing-kicker { padding-right: 4.75rem; }
    .classic-listing .listing-lane { background: var(--yellow); }
    .queue-status {
      min-height: 1.5em;
      margin: 0.75rem 0 0;
      color: var(--muted);
      font-size: 0.72rem;
      text-align: right;
    }

    .footer {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px dashed var(--ink);
      font-size: 0.75rem;
      color: #666;
      text-align: center;
    }
    .footer a { color: inherit; }

    .page-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin: 0 0 2rem;
    }
    .page-head.launchers-only { justify-content: flex-end; margin: 0 0 1.5rem; }
    .corner-launchers {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 1rem;
      color: var(--ink);
      flex-shrink: 0;
    }
    .corner-launchers a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: inherit;
      opacity: 0.55;
      transition: opacity 0.15s ease, color 0.15s ease, transform 0.1s ease;
    }
    .corner-launchers a:hover {
      opacity: 1;
      color: var(--hot);
      transform: translateY(-1px) rotate(-2deg);
    }
    .corner-launchers svg {
      width: 22px;
      height: 22px;
      display: block;
    }

    .live-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--hot);
      animation: livePulse 1.5s ease-in-out infinite;
    }
    @keyframes livePulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    /* Sports section (live recap tiles + yesterday recap tiles + today strip) */
    .sports-section { margin: 0 0 2.5rem; }
    .sports-recap-shell,
    .recap-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 0.85rem;
    }
    .sports-recap-shell > astro-island,
    .sports-recap-shell .recap-grid {
      display: contents;
    }
    @media (min-width: 720px) {
      .sports-recap-shell,
      .recap-grid { grid-template-columns: 1fr 1fr; }
    }
    .recap-tile {
      background: var(--paper);
      border: var(--border);
      box-shadow: var(--shadow);
      border-left-width: 8px;
      padding: 1rem 1.1rem;
      text-decoration: none;
      color: var(--ink);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      container-type: inline-size;
      transition: transform 0.05s ease, box-shadow 0.05s ease;
    }
    .recap-tile:hover {
      transform: translate(-2px, -2px);
      box-shadow: 8px 8px 0 var(--ink);
    }
    .recap-matchup {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .recap-team {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      flex: 1;
      min-width: 0;
    }
    .recap-team.home { flex-direction: row-reverse; text-align: right; }
    .recap-logo {
      width: 40px;
      height: 40px;
      object-fit: contain;
      flex-shrink: 0;
    }
    .recap-team-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
      line-height: 1.15;
    }
    .recap-team-name {
      font-family: 'Space Mono', monospace;
      font-weight: 700;
      font-size: 0.85rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .recap-team-abbr {
      font-size: 0.65rem;
      color: #666;
      letter-spacing: 0.06em;
    }
    @container (max-width: 430px) {
      .recap-team-name { display: none; }
      .recap-team-abbr {
        font-family: 'Space Mono', monospace;
        font-weight: 700;
        font-size: 0.85rem;
        line-height: 1.15;
        color: var(--ink);
        letter-spacing: 0;
      }
    }
    .recap-score {
      font-family: 'Permanent Marker', cursive;
      font-size: 1.7rem;
      line-height: 1;
      padding: 0 0.3rem;
      color: #666;
    }
    .recap-score.win { color: var(--ink); }
    .recap-vs {
      font-family: 'Permanent Marker', cursive;
      font-size: 0.85rem;
      color: #666;
      flex-shrink: 0;
    }
    .recap-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-top: 1px dashed #ccc;
      padding-top: 0.55rem;
    }
    .recap-final { font-weight: 700; color: #444; }
    .recap-watch { font-weight: 700; color: #0066cc; }

    .replay-controls { display: flex; align-items: center; justify-content: space-between; margin: -1rem 0 1rem; font-size: .75rem; color: #555; }
    .replay-controls button { background: transparent; border: 2px solid var(--ink); padding: .55rem .75rem; font: inherit; cursor: pointer; min-height: 44px; color: var(--ink); }
    .replay-slot { display: flex; justify-content: space-between; gap: .6rem; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
    .replay-slot > span:last-child { color: #666; white-space: nowrap; }
    .replay-note { font-size: .65rem; color: #666; line-height: 1.4; }
    .replay-pending { justify-content: center; min-height: 135px; box-shadow: 4px 4px 0 var(--ink); }
    .replay-pending p { font-size: .8rem; color: #666; margin: .4rem 0; }
    .replay-grid .recap-meta { gap: .5rem; flex-wrap: wrap; }

    /* Live tile variant — same big-tile chrome, with pulsing LIVE indicator
       and no winner/loser score emphasis (no winner yet). */
    .recap-tile.live .recap-score.live { color: var(--ink); }
    .recap-live-status {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-weight: 700;
      color: var(--hot);
    }
    .recap-live-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--hot);
      animation: livePulse 1.5s ease-in-out infinite;
    }

    /* MLB Big Inning live indicator — small pill above the live tile grid
       when the broadcast window is active. */
    .big-inning-pill {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.45rem 0.8rem 0.45rem 0.7rem;
