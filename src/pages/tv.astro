      grid-column: 1 / -1;
    }
    .big-inning-pill:hover {
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0 var(--ink);
    }
    .big-inning-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #bf0d3e;
      animation: livePulse 1.5s ease-in-out infinite;
      flex-shrink: 0;
    }
    .big-inning-label { font-weight: 700; }
    .big-inning-detail {
      color: #555;
      font-size: 0.72rem;
      letter-spacing: 0.03em;
    }
    .big-inning-platform {
      margin-left: auto;
      color: var(--cool);
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
    }

    /* Today schedule strip — small horizontal row under yesterday tiles */
    .schedule-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem;
    }
    .schedule-leader {
      font-family: 'Permanent Marker', cursive;
      font-size: 0.95rem;
      color: #555;
      letter-spacing: 0.02em;
      margin-right: 0.15rem;
    }
    .schedule-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.25rem 0.55rem 0.25rem 0.45rem;
