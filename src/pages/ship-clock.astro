---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShipClockApp from "../components/ShipClock.tsx";
import RepoTracker from "../components/RepoTracker.tsx";
const title = "Ship Clock — stanwood.dev";
---

<BaseLayout
  title={title}
  description="The latest stanwood.dev update, recent releases, and days since the last production deploy."
  slug="ship-clock"
  favicon="/favicon-ship-clock.svg"
  themeColor="#fffef5"
  fontsUrl="https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap"
  schemaCategory="DeveloperApplication"
>
  <Fragment slot="head">
    <style is:global>

      :root {
        --sc-bg: #fffef5;
        --sc-ink: #111;
        --sc-pixel: 3px;
        --sc-accent: #a63b19;
      }

      body {
        font-family: 'Cabin', sans-serif;
        background: var(--sc-bg);
        color: var(--sc-ink);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .sc-page {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        min-height: 100vh;
      }

      .sc-back {
        position: fixed;
        top: 20px;
        left: 20px;
        font-family: 'Space Mono', monospace;
        font-size: 13px;
        color: var(--sc-ink);
        text-decoration: none;
        opacity: 0.6;
        transition: opacity 0.2s;
      }
      .sc-back:hover { opacity: 1; }

      .sc-card {
        border: var(--sc-pixel) solid var(--sc-ink);
        box-shadow: 4px 4px 0 var(--sc-ink);
        background: #fff;
        padding: 48px 64px;
        text-align: center;
        max-width: 480px;
        width: 100%;
      }

      .sc-number {
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(72px, 20vw, 160px);
        line-height: 1;
        color: var(--sc-ink);
        margin-bottom: 8px;
      }

      .sc-today {
        font-size: clamp(32px, 8vw, 56px);
        color: var(--sc-accent);
      }

      .sc-label {
        font-family: 'Space Mono', monospace;
        font-size: clamp(14px, 3vw, 18px);
        letter-spacing: 0.05em;
        text-transform: lowercase;
        opacity: 0.7;
      }

      .sc-meta {
        font-family: 'Space Mono', monospace;
        font-size: 12px;
        margin-top: 24px;
        opacity: 0.4;
      }

      .sc-error {
        font-family: 'Space Mono', monospace;
        font-size: clamp(16px, 4vw, 22px);
        color: var(--sc-accent);
        margin-bottom: 8px;
      }

      .sc-retry { margin-top: 16px; padding: 10px 18px; min-height: 44px; border: 2px solid var(--sc-ink); background: var(--sc-ink); color: #fff; font: 700 13px 'Space Mono', monospace; cursor: pointer; }
      .sc-retry:focus-visible { outline: 3px solid var(--sc-accent); outline-offset: 4px; }

      .sc-wrap {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-width: 480px;
        width: 100%;
      }

      .sc-section-label {
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--sc-ink);
        opacity: 0.35;
        margin-bottom: 10px;
      }

      .sc-shipped-row {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 8px;
      }

      .sc-project-badge {
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        background: var(--sc-accent);
        color: #fff;
        padding: 2px 8px;
        white-space: nowrap;
      }

      .sc-shipped-summary {
        font-family: 'Cabin', sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: var(--sc-ink);
      }

      .sc-shipped-meta {
        display: flex;
        gap: 12px;
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        opacity: 0.4;
      }

      .sc-history {
        border: var(--sc-pixel) solid var(--sc-ink);
        box-shadow: 4px 4px 0 var(--sc-ink);
        background: #fff;
        padding: 20px 24px;
      }

      .sc-history-list {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .sc-history-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid rgba(0,0,0,0.06);
      }
      .sc-history-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
      .sc-history-row:first-child {
        padding-top: 0;
      }

      .sc-history-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--sc-ink);
        opacity: 0.25;
        flex-shrink: 0;
        margin-top: 6px;
      }

      .sc-history-body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }

      .sc-history-msg {
        font-family: 'Cabin', sans-serif;
        font-size: 13px;
        color: var(--sc-ink);
        opacity: 0.8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .sc-history-time {
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        color: var(--sc-ink);
        opacity: 0.35;
      }

      .sc-history-sha {
        opacity: 0.6;
      }

      .sc-meta-link {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dotted currentColor;
        transition: opacity 0.15s;
      }
      .sc-meta-link:hover { opacity: 1 !important; }
      .sc-status {
        font-family: 'Space Mono', monospace;
        font-size: clamp(11px, 2.5vw, 13px);
        letter-spacing: 0.08em;
        text-transform: lowercase;
        margin-top: 6px;
        opacity: 0.75;
      }
      .sc-status--hot  { color: var(--sc-accent); }
      .sc-status--good { color: #22c55e; }
      .sc-status--warn { color: #f59e0b; }
      .sc-status--bad  { color: #ef4444; }

      .sc-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
      }

      @media (max-width: 480px) {
        .sc-card {
          padding: 32px 24px;
        }
        .sc-history {
          padding: 14px 16px;
        }
      }
      .sc-rt-wrap {
        max-width: 480px;
        width: 100%;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1.5px solid rgba(0,0,0,0.08);
      }
      .sc-rt-row {
        display: flex;
        gap: 0;
      }
      .sc-rt-input {
        flex: 1;
        font-family: 'Space Mono', monospace;
        font-size: 12px;
        padding: 10px 14px;
        border: var(--sc-pixel) solid var(--sc-ink);
        background: #fff;
        color: var(--sc-ink);
        outline: none;
        min-width: 0;
      }
      .sc-rt-input::placeholder { opacity: 0.3; }
      .sc-rt-input:focus { background: #fffef5; }
      .sc-rt-btn {
        font-family: 'Space Mono', monospace;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: lowercase;
        padding: 10px 18px;
        border: var(--sc-pixel) solid var(--sc-ink);
        border-left: none;
        background: var(--sc-ink);
        color: var(--sc-bg);
        cursor: pointer;
        transition: background 0.15s;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .sc-rt-btn:hover:not(:disabled) {
        background: var(--sc-accent);
        border-color: var(--sc-accent);
      }
      .sc-rt-btn:disabled { opacity: 0.5; cursor: not-allowed; }
      .sc-rt-error {
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        color: var(--sc-accent);
        margin: 8px 0 0;
        opacity: 0.8;
      }
      .sc-rt-result {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 16px;
      }
      .sc-rt-meta-card {
        border: var(--sc-pixel) solid var(--sc-ink);
        box-shadow: 4px 4px 0 var(--sc-ink);
        background: #fff;
        padding: 16px 20px;
      }
      .sc-intro {
        text-align: center;
        margin-bottom: 20px;
        max-width: 480px;
        width: 100%;
      }
      .sc-intro-title {
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(32px, 9vw, 52px);
        color: var(--sc-accent);
        margin: 0 0 4px;
        line-height: 1.05;
      }
      .sc-intro-sub { color:#6d6b63;
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        color: var(--sc-ink);
        opacity:1;
        margin: 0 0 10px;
        letter-spacing: 0.08em;
        text-transform: lowercase;
      }
      .sc-page { justify-content: flex-start; min-height: auto; padding-top: 88px; gap: 24px; }
      .sc-intro { margin: 0; }
      .sc-track-another { width: 100%; max-width: 480px; font-size: 13px; }
      .sc-track-another summary { cursor: pointer; padding: 14px 0; border-bottom: 1px solid #cbc9be; }

</style>
  </Fragment>

  <div class="sc-page">
    <a href="/" class="sc-back">← stanwood.dev</a>

    <div class="sc-intro">
      <h1 class="sc-intro-title">Ship Clock</h1>
      <p class="sc-intro-sub">The latest from stanwood.dev.</p>
    </div>
    <ShipClockApp client:idle />

    <details class="sc-track-another">
      <summary>Check another GitHub repo</summary>
      <RepoTracker client:visible />
    </details>

  </div>

</BaseLayout>
