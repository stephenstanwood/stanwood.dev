---
import BaseLayout from "../layouts/BaseLayout.astro";
import SwimWorkout from "../components/SwimWorkout.tsx";
---
<BaseLayout
  title="Lap Lab — stanwood.dev"
  description="Pick your pool, pace, and time. Get a swim workout with warmup, main set, and cooldown."
  slug="swim" favicon="/favicon-swim.svg" themeColor="#f4f9f8"
  schemaCategory="HealthApplication" schemaName="Lap Lab"
>
  <div class="swim-shell">
    <a href="/" class="retro-back">← stanwood.dev</a>
    <header class="swim-heading">
      <span class="swim-kicker">A little time in the water.</span>
      <h1>Lap Lab<span aria-hidden="true"> ≋</span></h1>
      <p>Your pool. Your pace. Your next swim.</p>
    </header>
    <SwimWorkout client:load />
    <details class="swim-help">
      <summary>Reading your workout</summary>
      <p><strong>4 × 100</strong> means four swims of 100 meters or yards. An interval like <strong>@ 2:00</strong> means start a new swim every two minutes; the remaining time is your rest. Swim at a comfortable effort unless the set says otherwise.</p>
    </details>
    <noscript><p>Turn on JavaScript to generate a workout.</p></noscript>
  </div>
</BaseLayout>
<style is:global>
  body { background: #f4f9f8; color: #153a36; font-family: 'Inter', sans-serif; }
  .swim-shell { width: min(100% - 40px, 680px); margin: 0 auto; padding: 32px 0 64px; }
  .swim-heading { margin: 36px 0 28px; padding-bottom: 24px; border-bottom: 3px solid #15756b; }
  .swim-kicker { font-size: 12px; color: #466962; }
  .swim-heading h1 { font-size: clamp(42px, 9vw, 64px); line-height: 1.1; font-weight: 750; letter-spacing: -.055em; margin: 8px 0; }
  .swim-heading h1 span { color: #15756b; }
  .swim-heading p { color: #466962; font-size: 16px; }
  .swim-config { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .swim-config label { font-size: 12px; color: #466962; font-weight: 600; }
  .swim-config select { display: block; width: 100%; margin-top: 8px; padding: 12px; border: 1px solid #b4cbc6; border-radius: 8px; background: white; color: #153a36; font: 500 15px 'Inter', sans-serif; min-height: 48px; }
  .swim-options, .swim-help, .swim-recent { border-bottom: 1px solid #cbdcd7; padding: 16px 0; }
  .swim-options summary, .swim-help summary, .swim-recent summary { cursor: pointer; font-size: 13px; font-weight: 600; min-height: 28px; }
  .swim-help p { font-size: 13px; line-height: 1.7; color: #466962; margin-top: 12px; }
  .swim-options > div, .swim-recent > div { margin-top: 16px; }
  .swim-generate { width: 100%; min-height: 52px; background: #15756b; color: white; border-radius: 8px; font-weight: 650; margin-top: 20px; cursor: pointer; }
  .swim-generate:hover { background: #105f57; }
  .swim-shell .text-stone-400 { color: #59736c; }
  .swim-shell .text-stone-500 { color: #526b64; }
  @media (max-width: 480px) { .swim-config { grid-template-columns: 1fr 1fr; gap: 12px; } .swim-config label:last-child { grid-column: 1 / -1; } .swim-heading { margin-top: 28px; } }
  @media print {
    body * { visibility: hidden; }
    .print-workout, .print-workout * { visibility: visible; }
    .print-workout { display: block !important; position: absolute; left: 0; top: 0; width: 100%; max-width: none; padding: 0 20px; }
    .print-workout > div { break-inside: avoid; }
    @page { size: letter; margin: .5in; }
  }
</style>
