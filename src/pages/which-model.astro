---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhichModelPicker from "../components/WhichModel";
---
<BaseLayout title="Which Model? — stanwood.dev" description="Pick your task. Find a sensible AI tool to start with." slug="which-model" favicon="/favicon-which-model.svg" themeColor="#fffdf5" fontsUrl="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Space+Grotesk:wght@400;500;600;700&display=swap" schemaCategory="UtilitiesApplication" schemaName="Which Model?">
  <div class="wm-page">
    <header><span class="wm-kicker">A little less overthinking</span><h1>Which model?</h1><p>What you want to do matters more than the leaderboard.</p></header>
    <WhichModelPicker client:load />
    <noscript><p>For writing, try <a href="https://claude.com/product/overview">Claude</a>. For code, <a href="https://openai.com/codex/">Codex</a>. For long documents, <a href="https://ai.google.dev/gemini-api/docs/long-context">Gemini</a>.</p></noscript>
  </div>
</BaseLayout>
<style is:global>
  body { margin:0; background:#fffdf5; color:#24251e; font-family:'Space Grotesk',sans-serif; }
  .wm-page { width:min(700px,calc(100% - 40px)); margin:0 auto; padding:100px 0 56px; }
  .wm-kicker,.wm-answer-label { font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:#625f50; }
  .wm-page h1 { font-family:'DM Serif Display',serif; font-weight:400; font-size:clamp(44px,8vw,76px); line-height:1.04; letter-spacing:-.045em; margin:12px 0 16px; }
  .wm-page header>p { font-size:18px; line-height:1.5; max-width:440px; color:#625f50; margin:0 0 36px; }
  .wm-tasks { border:0; padding:0; margin:0 0 28px; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
  .wm-tasks legend { font-weight:600; font-size:14px; margin-bottom:14px; }
  .wm-choice { position:relative; border:1px solid #d9d6ca; border-radius:7px; padding:15px; cursor:pointer; display:flex; align-items:center; gap:10px; font-size:15px; }
  .wm-choice input { accent-color:#292a21; width:16px; height:16px; flex:none; }
  .wm-choice.selected { background:#f5c542; border-color:#292a21; }
  .wm-choice:focus-within { outline:3px solid #397661; outline-offset:3px; }
  .wm-answer { border-top:2px solid #292a21; padding:24px 0 12px; }
  .wm-answer h2 { margin:12px 0; font-size:40px; letter-spacing:-.04em; display:flex; justify-content:space-between; }
  .wm-answer h2 span { color:#8c8b75; font-weight:400; }
  .wm-answer p { font-size:17px; line-height:1.65; max-width:560px; margin:0 0 24px; }
  .wm-answer a { display:inline-flex; align-items:center; gap:24px; min-height:46px; background:#292a21; color:#fffdf5; padding:0 20px; border-radius:5px; text-decoration:none; font-weight:600; }
  .wm-footnote { font-size:12px; line-height:1.7; color:#625f50; max-width:560px; margin-top:26px; }
  @media(max-width:380px) { .wm-choice { padding:12px 9px; font-size:13px; } .wm-page{padding-top:80px;} }
</style>
