---
import BaseLayout from "../layouts/BaseLayout.astro";
import DriverlessDashboard from "../components/driverless/DriverlessDashboard";
---
<BaseLayout title="Driverless — Where to ride, what the numbers say" description="A concise look at driverless rides: current Waymo service areas and dated, sourced safety comparisons." slug="driverless" favicon="/favicon-driverless.svg" themeColor="#f8faf8" fontsUrl="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700&display=swap">
  <DriverlessDashboard client:load />
</BaseLayout>
<style is:global>
  body { background:#f8faf8; color:#172b24; font-family:Inter,sans-serif; margin:0; }
  .dl-page { width:min(960px,calc(100% - 40px)); margin:0 auto; padding:92px 0 40px; }
  .dl-kicker { font-size:12px; color:#53685d; letter-spacing:.1em; text-transform:uppercase; }
  .dl-heading h1 { font:400 clamp(46px,7vw,80px)/1.02 'DM Serif Display',serif; letter-spacing:-.04em; margin:14px 0 20px; }
  .dl-heading>p { font-size:18px; color:#53685d; line-height:1.6; margin-bottom:36px; }
  .dl-facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-top:1px solid #c9d8d0; border-bottom:1px solid #c9d8d0; padding:24px 0; gap:20px; }
  .dl-facts strong { display:block; font-size:clamp(32px,5vw,48px); letter-spacing:-.05em; font-weight:600; margin-bottom:10px; }
  .dl-facts span { font-size:12px; line-height:1.6; color:#53685d; }
  .dl-rides,.dl-safety { margin:44px 0; }
  .dl-section-head { display:flex; align-items:baseline; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:20px; }
  .dl-section-head h2 { margin:0; font-weight:600; font-size:26px; letter-spacing:-.03em; }
  .dl-section-head>a,.dl-section-head>span { font-size:12px; color:#53685d; }
  .dl-search { display:block; max-width:440px; }
  .dl-search>span { display:block; font-size:12px; margin-bottom:8px; color:#53685d; }
  .dl-search input { width:100%; box-sizing:border-box; min-height:48px; padding:12px; border:1px solid #abbfb2; border-radius:5px; background:white; color:#172b24; font:inherit; font-size:15px; }
  .dl-search-count { font-size:12px; color:#53685d; margin:14px 0; }
  .dl-city-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); list-style:none; padding:0; column-gap:36px; }
  .dl-city-list li { display:flex; justify-content:space-between; align-items:center; gap:8px; border-bottom:1px solid #d8e2dc; min-height:52px; font-size:14px; }
  .dl-city-list small { color:#53685d; font-size:11px; margin-left:5px; }
  .dl-city-list a { font-size:11px; white-space:nowrap; padding:12px 0; }
  .dl-page a { color:#2f6752; text-underline-offset:3px; text-decoration:underline; }
  .dl-note,.dl-footer { font-size:12px; line-height:1.7; color:#53685d; }
  .dl-note { margin:20px 0 0; max-width:660px; }
  .dl-safety>p { font-size:14px; line-height:1.7; color:#53685d; max-width:600px; }
  .dl-safety ul { list-style:none; padding:0; margin:24px 0; max-width:650px; }
  .dl-safety li { margin:20px 0; }
  .dl-safety li>div:first-child { display:flex; justify-content:space-between; gap:12px; font-size:14px; margin-bottom:9px; }
  .dl-bar { height:6px; border-radius:3px; background:#dce6df; overflow:hidden; }
  .dl-bar span { display:block; height:100%; background:#4a8268; }
  .dl-safety details { border-top:1px solid #c9d8d0; padding:18px 0; font-size:13px; line-height:1.7; max-width:650px; }
  .dl-safety summary { cursor:pointer; min-height:28px; }
  .dl-safety details p { color:#53685d; }
  .dl-empty button { font:inherit; padding:12px; border:1px solid #c9d8d0; background:white; border-radius:5px; }
  @media(max-width:600px) { .dl-page{padding-top:78px;} .dl-facts{grid-template-columns:1fr;gap:22px;} .dl-facts>div{display:grid;grid-template-columns:120px 1fr;align-items:center;gap:12px;} .dl-facts strong{margin:0;font-size:36px;} .dl-city-list{grid-template-columns:1fr;} }
</style>
